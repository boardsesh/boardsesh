# syntax=docker/dockerfile:1.26@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
FROM node:22-bookworm-slim
WORKDIR /app
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN npm install --global --no-fund --no-audit pnpm@11.22.0
COPY manifests/package.json manifests/pnpm-lock.yaml manifests/pnpm-workspace.yaml ./
COPY manifests/patches ./patches
COPY manifests/packages/db/patches ./packages/db/patches
RUN --mount=type=cache,id=background-worker-pnpm-store,target=/pnpm/store pnpm fetch
COPY manifests/packages ./packages
RUN --mount=type=cache,id=background-worker-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --offline --filter boardsesh-backend...
COPY source/packages ./packages
ENV NODE_ENV=production
ENV DB_POOL_MAX=2
ENV PGBOSS_POOL_SIZE=1
ENV WORKER_CONCURRENCY=1
ENV WORKER_PAUSED=true
USER node
EXPOSE 9090
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:9090/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "--import", "tsx", "packages/backend/src/workers/index.ts"]
