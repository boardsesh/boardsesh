# ONNX Runtime ships glibc CPU binaries. Alpine/musl is not supported.
FROM node:22-bookworm-slim
WORKDIR /app
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN npm install --global --no-fund --no-audit pnpm@11.22.0
COPY manifests/package.json manifests/pnpm-lock.yaml manifests/pnpm-workspace.yaml ./
COPY manifests/patches ./patches
COPY manifests/packages/db/patches ./packages/db/patches
RUN --mount=type=cache,id=hold-detector-pnpm-store,target=/pnpm/store pnpm fetch
COPY manifests/packages ./packages
RUN --mount=type=cache,id=hold-detector-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --offline --filter @boardsesh/hold-detector...
COPY source/packages ./packages
ENV NODE_ENV=production
ENV DB_POOL_MAX=3
ENV MODEL_CACHE_DIR=/var/cache/hold-detector
RUN mkdir -p /var/cache/hold-detector && chown node:node /var/cache/hold-detector
USER node
EXPOSE 9090
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:9090/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "--import", "tsx", "packages/hold-detector/src/index.ts"]
