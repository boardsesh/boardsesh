{
  "//": "Typechecks the repo-root scripts wired into typecheck:scripts, including the Discord feedback pipeline, development tooling, board-art generation, Railway configuration, iOS profiling/build/simulator ownership tools, and the store-screenshot baseline/compare pipeline, with their regression tests.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "discord-feedback-scan.ts",
    "lib/discord-feedback.ts",
    "lib/discord-feedback-issue.ts",
    "__tests__/discord-feedback-scan.test.ts",
    "dev-db-discover.ts",
    "__tests__/dev-db-discover-watchdog.test.ts",
    "check-pr-test-plan.ts",
    "lib/pr-labels.ts",
    "__tests__/pr-test-plan-workflow.test.ts",
    "__tests__/pr-labels.test.ts",
    "generate-board-art-geometry.ts",
    "outline-overrides-merge.ts",
    "outline-overrides-merge.test.ts",
    "canonical-outlines.ts",
    "canonical-outlines.test.ts",
    "railway-apply.ts",
    "railway-apply.test.ts",
    "screenshot-backend.ts",
    "lib/screenshot-backend.ts",
    "lib/screenshot-fixtures.ts",
    "__tests__/screenshot-backend.test.ts",
    "__tests__/screenshot-backend-cli.test.ts",
    "__tests__/screenshot-fixtures.test.ts",
    "assert-screenshot-dimensions.ts",
    "assert-screenshot-content.ts",
    "compare-screenshots.ts",
    "screenshot-baseline.ts",
    "screenshot-probe-scope.ts",
    "__tests__/compare-screenshots.test.ts",
    "__tests__/screenshot-baseline.test.ts",
    "__tests__/screenshot-probe-scope.test.ts",
    "__tests__/assert-screenshot-content.test.ts",
    "__tests__/mobile-screenshots-workflows.test.ts",
    "../infra/railway/config.ts",
    "../infra/railway/plan.ts",
    "mobile-profile-capture.ts",
    "mobile-profile-ios.ts",
    "mobile-simulator-lease.ts",
    "mobile-simulator-smoke.ts",
    "lib/ios-profile-identity.ts",
    "lib/ios-simulator-lease.ts",
    "lib/ios-build-export.ts",
    "lib/metro-host.ts",
    "lib/metro-dev-server.ts",
    "lib/android-dev-client.ts",
    "mobile-ios-run.ts",
    "mobile-build-sim-app.ts",
    "mobile-dev-start.ts",
    "mobile-screenshots.ts",
    "mobile-ios-shots.ts",
    "mobile-android-apk.ts",
    "mobile-android-shots.ts",
    "__tests__/ios-profiling-tools.test.ts",
    "__tests__/mobile-ios-run.test.ts",
    "__tests__/mobile-screenshots.test.ts",
    "__tests__/mobile-profile-capture.test.ts",
    "__tests__/mobile-android-apk.test.ts",
    "__tests__/with-android-dev-menu-defaults.test.ts"
  ]
}
