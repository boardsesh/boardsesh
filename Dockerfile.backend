# Backend service - runs TypeScript directly via tsx
FROM node:22-alpine

WORKDIR /app

# pnpm, pinned to package.json's `packageManager` field. npm is already in the
# base image; avoiding corepack also avoids its independently pinned signing
# keys becoming a build-time dependency.
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN npm install --global --no-fund --no-audit pnpm@11.22.0

# The workflow builds from .docker-context/backend, generated by
# scripts/create-service-docker-context.mjs. That context contains all root
# workspace manifests for the pnpm install layer and only backend source after
# it. pnpm-workspace.yaml carries the workspace globs, overrides and patches.
COPY manifests/package.json manifests/pnpm-lock.yaml manifests/pnpm-workspace.yaml ./
COPY manifests/packages ./packages
# Patch files referenced by pnpm-workspace.yaml must be present before install.
COPY manifests/patches ./patches

# Keep devDependencies because tsx is the runtime TypeScript loader. The store
# cache never enters an image layer.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

# Source-only edits land after install, so they do not invalidate the dependency layer.
COPY source/packages ./packages

# Stamp release identity into source. The backend executes TypeScript directly,
# so this file remains immutable for the lifetime of the published image.
ARG BOARDSESH_BUILD_RELEASE
RUN if [ "${#BOARDSESH_BUILD_RELEASE}" -ne 40 ]; then \
      echo "BOARDSESH_BUILD_RELEASE must be a 40-character lowercase Git SHA" >&2; \
      exit 1; \
    fi \
    && case "$BOARDSESH_BUILD_RELEASE" in \
      *[!0-9a-f]*) echo "BOARDSESH_BUILD_RELEASE must be a 40-character lowercase Git SHA" >&2; exit 1 ;; \
    esac \
    && test "$(grep -Fxc "const STAMPED_RELEASE = 'BOARDSESH_BUILD_RELEASE_UNSTAMPED';" packages/backend/src/build-release.ts)" -eq 1 \
    && sed -i "s/BOARDSESH_BUILD_RELEASE_UNSTAMPED/$BOARDSESH_BUILD_RELEASE/" \
      packages/backend/src/build-release.ts \
    && grep -Fqx "const STAMPED_RELEASE = '$BOARDSESH_BUILD_RELEASE';" packages/backend/src/build-release.ts \
    && ! grep -qF 'BOARDSESH_BUILD_RELEASE_UNSTAMPED' packages/backend/src/build-release.ts

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# Run tsx in-process so the backend, rather than a CLI supervisor, owns PID 1.
WORKDIR /app/packages/backend
CMD ["node", "--import", "tsx", "src/index.ts"]
