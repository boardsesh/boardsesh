{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discord mention issue decisions",
  "description": "Output contract for one authorized Discord issue command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "description": "One issue by default; multiple only when the maintainer instruction explicitly asks for them.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commandMessageId",
          "issueIndex",
          "verdict",
          "title",
          "body",
          "labels",
          "duplicateOf",
          "rationale"
        ],
        "properties": {
          "commandMessageId": {
            "type": "string",
            "description": "Must exactly match bundle.command.messageId."
          },
          "issueIndex": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Unique, sequential index starting at 1."
          },
          "verdict": {
            "enum": ["bug", "feature", "duplicate"]
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "body": {
            "type": "string",
            "description": "Markdown issue body without source metadata or HTML comments."
          },
          "labels": {
            "type": "array",
            "items": {
              "enum": [
                "android",
                "bug",
                "enhancement",
                "from-discord",
                "ios",
                "mobile",
                "priority:P0",
                "priority:P1",
                "priority:P2",
                "priority:P3",
                "user-feedback",
                "web"
              ]
            }
          },
          "duplicateOf": {
            "type": ["string", "null"],
            "description": "For duplicate only: the full existing GitHub issue URL."
          },
          "rationale": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "verdict": { "enum": ["bug", "feature"] } },
              "required": ["verdict"]
            },
            "then": {
              "properties": {
                "title": { "minLength": 8 },
                "body": { "minLength": 1 },
                "duplicateOf": { "type": "null" }
              }
            }
          },
          {
            "if": {
              "properties": { "verdict": { "const": "duplicate" } },
              "required": ["verdict"]
            },
            "then": {
              "properties": {
                "duplicateOf": {
                  "type": "string",
                  "pattern": "^https://github\\.com/boardsesh/boardsesh/issues/[0-9]+$"
                }
              }
            }
          }
        ]
      }
    }
  }
}
