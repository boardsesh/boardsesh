# Sync CLIs - runs any sync CLI (kilter/aurora/moonboard) directly via tsx.
# Sibling of Dockerfile.backend. The actual command is supplied by the container
# `command:` (e.g. docker-compose), so one image serves every sync CLI. kilter
# and aurora expose a long-running `daemon`; moonboard is locations-only (no
# daemon subcommand):
#   node --import tsx packages/kilter-sync/src/cli/index.ts daemon
#   node --import tsx packages/aurora-sync/src/cli/index.ts daemon
#   node --import tsx packages/moonboard-sync/src/cli/index.ts locations
FROM node:22-alpine

WORKDIR /app

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN npm install --global --no-fund --no-audit pnpm@11.22.0

# The workflow builds from .docker-context/sync, generated by
# scripts/create-service-docker-context.mjs. That context contains all root
# workspace manifests for the pnpm install layer and only the sync packages'
# (and their transitive workspace deps') source after it.
COPY manifests/package.json manifests/pnpm-lock.yaml manifests/pnpm-workspace.yaml ./
COPY manifests/packages ./packages
# Patch files referenced by pnpm-workspace.yaml must be present before install.
COPY manifests/patches ./patches

# Keep devDependencies because tsx is the runtime TypeScript loader.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

# Source-only edits land after install, so they do not invalidate the dependency layer.
COPY source/packages ./packages

# No baked subcommand: the docker-compose `command:` selects the CLI/daemon.
# WORKDIR stays /app so command paths are repo-relative. Default prints usage.
CMD ["node", "--import", "tsx", "packages/kilter-sync/src/cli/index.ts", "--help"]
