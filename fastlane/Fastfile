# Uploads native store screenshots to App Store Connect / Google Play.
#
# Screenshots only — no binary, no text metadata, no review submission. The
# screenshots are captured fresh by `vp run mobile:screenshots` (see
# scripts/mobile-screenshots.ts) into the canonical trees:
#
#   app-stores/apple/screenshots/<app-store-locale>/<device>/NN-name.png
#   app-stores/google/screenshots/<device>/NN-name.png
#
# App Store Connect wants <screenshots_path>/<locale>/NN-name.png, so we stage
# each locale into a flat temp path and prefix each file with its device slug to
# avoid cross-device filename collisions. deliver routes each image to its display
# slot by pixel dimensions; the NN- filename prefixes still set display order
# inside each slot.
#
# Google Play wants metadata_path/android/<locale>/images/phoneScreenshots/*.png,
# so we stage the captured phone screenshots into that fastlane supply layout. The
# Play listing lanes then commit through fastlane/lib/play_listing.rb, not supply,
# so a listing push can never cancel a release that is in review.

require "fileutils"
require "tmpdir"

opt_out_usage
default_platform(:ios)

REPO_ROOT = File.expand_path("..", __dir__)
APPLE_SCREENSHOTS_ROOT = File.join(REPO_ROOT, "app-stores", "apple", "screenshots")
GOOGLE_SCREENSHOTS_DIR = File.join(REPO_ROOT, "app-stores", "google", "screenshots", "pixel-2")
EXPECTED_DELIVER_LOCALES = ["en-US", "es-ES", "es-MX", "fr-FR", "de-DE"].freeze
SUPPLY_LOCALE = "en-US"

APP_IDENTIFIER = "com.boardsesh.app"

# Committed store listing text. deliver reads <metadata_path>/<locale>/*.txt;
# supply reads the same under an android/ root. These trees are the source of
# truth for the listing copy — see app-stores/apple|google/*.md for the pointers
# and the operational material (review notes, privacy labels) that can't be
# uploaded.
#
# Anchor to REPO_ROOT (an absolute path), NOT __dir__. fastlane evaluates the
# Fastfile through instance_eval, where __dir__ resolves to "." rather than this
# file's directory — so File.join(__dir__, ...) yields a *relative* path like
# "./metadata/android". deliver runs from fastlane/ so "./metadata" happens to
# resolve, but supply runs from the repo root, where "./metadata/android" does
# not exist ("Could not find folder ./metadata/android"). REPO_ROOT is already
# absolutised via File.expand_path, so these paths resolve from any CWD.
APPLE_METADATA_DIR = File.join(REPO_ROOT, "fastlane", "metadata")
ANDROID_METADATA_DIR = File.join(REPO_ROOT, "fastlane", "metadata", "android")

# Marketing version, read from the Expo app config. Anchored to a top-level
# `version:` line whose value starts with a digit (semver), so a nested plugin
# `version:` can't be matched by accident. The build workflows parse the same
# field — keep them in sync if the config layout changes.
def mobile_app_version
  config_path = File.join(REPO_ROOT, "packages", "mobile", "app.config.ts")
  match = File.read(config_path).match(/^[ \t]*version:\s*['"](\d[^'"]*)['"]/)
  UI.user_error!("Could not find version in #{config_path}") unless match
  match[1]
end

# App Store Connect API key from the same env vars the screenshot/TestFlight
# workflows already provide (APP_STORE_CONNECT_API_KEY_ID / _ISSUER_ID and
# ASC_KEY_PATH pointing at the decoded .p8).
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    is_key_content_base64: false,
    in_house: false
  )
end

# The App Store version deliver would edit (Prepare for Submission / a rejected
# state), nil when there is none, or :unknown when App Store Connect could not be
# asked. Mirrors deliver's own lookup (App#get_edit_app_store_version), with one
# difference: that lookup also returns a version WAITING_FOR_REVIEW, and once a
# merge-back has submitted a version (mobile-store-submit.yml) a listing or
# screenshot push must not touch it, so that state counts as nothing to edit.
# Requires the Spaceship token to already be set (asc_api_key /
# app_store_connect_api_key set it by default).
def editable_app_store_version
  require "spaceship"
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  if app.nil?
    UI.important("App #{APP_IDENTIFIER} not found on App Store Connect; not pushing anything to it.")
    return :unknown
  end
  edit_version = app.get_edit_app_store_version
  return nil if edit_version.nil?
  state = edit_version.app_version_state || edit_version.app_store_state
  if state == "WAITING_FOR_REVIEW"
    UI.important("App Store version #{edit_version.version_string} is waiting for review; not changing its listing or screenshots.")
    return nil
  end
  edit_version
rescue => error
  UI.important("Could not check for an editable App Store version (#{error.message}); not pushing. Rerun once App Store Connect answers.")
  :unknown
end

# True when App Store Connect has a version deliver can edit, false when there is
# none, so the `metadata` and `screenshots` lanes can skip instead of letting
# deliver retry "Cannot find edit app store version" for ~20 minutes. When the
# check itself fails it also returns false: deliver's own lookup would include a
# version waiting for review, and since the merge-back submission sends versions
# for review unattended, a push must not run blind. A skipped push is one rerun.
def editable_app_store_version_present?
  edit_version = editable_app_store_version
  !edit_version.nil? && edit_version != :unknown
end

# App Store version states in which a version is not out yet: being prepared,
# sent back by Apple or by us, queued for or in review, or approved and waiting
# to be released. deliver's version check (App#ensure_version!) renames the
# editable version to whatever version it is asked to draft, so drafting 2.7.1
# while 2.7.0 is editable would quietly turn the 2.7.0 someone is about to
# submit into 2.7.1. An approved 2.7.0 is not editable, but the next version
# still waits until it is released. The list lives in
# lib/app_store_version_states.rb, shared with the merge-back submission's
# status check so both agree on what holds the next version.
require File.join(REPO_ROOT, "fastlane", "lib", "app_store_version_states")
OPEN_APP_STORE_VERSION_STATES = BoardseshAppStoreVersionStates::OPEN

# The open iOS versions (raw appStoreVersions resources) carrying a version
# string other than `version`, described as "2.7.0 (PREPARE_FOR_SUBMISSION)".
def other_open_app_store_versions(app_store_versions, version)
  app_store_versions.filter_map do |resource|
    attributes = resource.fetch("attributes", {})
    state = attributes["appVersionState"] || attributes["appStoreState"]
    next unless attributes["platform"] == "IOS" && OPEN_APP_STORE_VERSION_STATES.include?(state)
    next if attributes["versionString"] == version
    "#{attributes['versionString']} (#{state})"
  end
end

# Hand a resolved number back to the calling GitHub Actions step via the step's
# output file (consumed as steps.<id>.outputs.value). No-op when run locally.
def emit_ci_output(value)
  github_output = ENV["GITHUB_OUTPUT"]
  return if github_output.nil? || github_output.empty?
  File.open(github_output, "a") { |file| file.puts("value=#{value}") }
end

# Append a line to the job's step summary (rendered on the Actions run page), so
# a clean skip is visible without opening the logs — a green job that uploaded
# nothing otherwise reads as a normal success. No-op when run locally.
def emit_step_summary(message)
  github_step_summary = ENV["GITHUB_STEP_SUMMARY"]
  return if github_step_summary.nil? || github_step_summary.empty?
  File.open(github_step_summary, "a") { |file| file.puts(message) }
end

def pngs_for_locale(locale)
  locale_dir = File.join(APPLE_SCREENSHOTS_ROOT, locale)
  unless Dir.exist?(locale_dir)
    UI.user_error!("Missing screenshots for App Store locale #{locale}. Run `vp run mobile:screenshots -- --locales all --devices common` first.")
  end

  device_dirs = Dir.children(locale_dir).select { |entry| File.directory?(File.join(locale_dir, entry)) }.sort
  UI.user_error!("No device screenshot folders found for App Store locale #{locale}.") if device_dirs.empty?

  device_dirs.to_h do |device_slug|
    pngs = Dir.glob(File.join(locale_dir, device_slug, "*.png")).sort
    UI.user_error!("No PNGs found for App Store locale #{locale}, device #{device_slug}.") if pngs.empty?
    [device_slug, pngs]
  end
end

def screenshot_manifest
  UI.user_error!("No screenshots directory at #{APPLE_SCREENSHOTS_ROOT}. Run `vp run mobile:screenshots` first.") unless Dir.exist?(APPLE_SCREENSHOTS_ROOT)

  unexpected_locales = Dir.children(APPLE_SCREENSHOTS_ROOT)
    .select { |entry| File.directory?(File.join(APPLE_SCREENSHOTS_ROOT, entry)) }
    .reject { |locale| EXPECTED_DELIVER_LOCALES.include?(locale) }
    .sort
  unless unexpected_locales.empty?
    UI.user_error!("Unknown App Store screenshot locale folder(s): #{unexpected_locales.join(', ')}.")
  end

  manifest = EXPECTED_DELIVER_LOCALES.to_h { |locale| [locale, pngs_for_locale(locale)] }
  reference_locale = EXPECTED_DELIVER_LOCALES.first
  reference_devices = manifest.fetch(reference_locale).keys.sort

  manifest.each do |locale, devices|
    device_slugs = devices.keys.sort
    if device_slugs != reference_devices
      UI.user_error!("Device folders for #{locale} are #{device_slugs.join(', ')}, expected #{reference_devices.join(', ')}.")
    end

    reference_devices.each do |device_slug|
      expected_names = manifest.fetch(reference_locale).fetch(device_slug).map { |path| File.basename(path) }
      actual_names = devices.fetch(device_slug).map { |path| File.basename(path) }
      if actual_names != expected_names
        UI.user_error!("Screenshot files for #{locale}/#{device_slug} do not match #{reference_locale}/#{device_slug}.")
      end
    end
  end

  manifest
end

def staged_filename(device_slug, png_path)
  basename = File.basename(png_path)
  staged = basename.sub(/\A(\d+)-/, "\\1-#{device_slug}-")
  staged == basename ? "#{device_slug}-#{basename}" : staged
end

# A precautionary retry for the App Store screenshot upload. App Store Connect
# throws sporadic 500s (Spaceship::InternalServerError) that deliver only
# auto-retries on 503, so a single bad gateway response would otherwise fail the
# whole upload (seen in run 27719803749). Retries ONLY transient server-side errors
# (5xx / timeout / temporary) with a short linear backoff; a real failure (bad
# credentials, a rejected screenshot) is re-raised on the first attempt rather than
# looped on. deliver runs with sync_screenshots, so a retried upload reconciles
# against the staged files instead of duplicating. The Play lanes do not retry: an
# ambiguous commit there is never repeated blindly, and a rerun reconciles.
TRANSIENT_UPLOAD_ERROR = /5\d\d|server error|timed?\s?out|timeout|temporar|try again|connection reset|bad gateway|service unavailable|internal server/i

def with_upload_retries(max_attempts: 3, base_sleep: 30)
  attempt = 0
  begin
    attempt += 1
    yield
  rescue => error
    transient = error.message.to_s.match?(TRANSIENT_UPLOAD_ERROR) ||
                error.class.name.to_s.match?(/InternalServerError|TemporaryError|ServerError|Timeout/)
    raise if !transient || attempt >= max_attempts
    delay = base_sleep * attempt
    UI.important("Store upload attempt #{attempt}/#{max_attempts} hit a transient error (#{error.class}: #{error.message.to_s.lines.first&.strip}). Retrying in #{delay}s…")
    sleep(delay)
    retry
  end
end

# Push the committed Play listing parts (listing, images, screenshots) through one
# review-protected edit of our own; see fastlane/lib/play_listing.rb for why
# supply's commit is not used. metadata_path is a supply-style tree
# (<locale>/*.txt, <locale>/images/...).
def push_play_listing(parts:, metadata_path: ANDROID_METADATA_DIR)
  require File.join(REPO_ROOT, "fastlane", "lib", "play_listing")
  credential = ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"] || ENV["GOOGLE_PLAY_JSON_KEY"]
  service = -> { BoardseshAndroidRelease.service(json_key_data: credential) }
  receipt = BoardseshPlayListing::Runner.new(service: service, metadata_path: metadata_path, parts: parts).run
  receipt.fetch("changes").each { |change| UI.message(change) }
  UI.success("Committed the Play #{parts.join(' + ')} for #{receipt.fetch('languages').join(', ')} with review protection.")
  receipt
rescue BoardseshPlayListing::Error, BoardseshAndroidRelease::Error => error
  UI.user_error!(error.message)
end

platform :ios do
  desc "Export the signed archive and upload to TestFlight with the existing export options"
  lane :testflight do
    %w[ARCHIVE_PATH EXPORT_OPTIONS_PLIST EXPORT_PATH].each do |name|
      UI.user_error!("Missing #{name}") if ENV.fetch(name).empty?
    end
    archive = File.expand_path(ENV.fetch("ARCHIVE_PATH"), REPO_ROOT)
    export_options = File.expand_path(ENV.fetch("EXPORT_OPTIONS_PLIST"), REPO_ROOT)
    export_path = File.expand_path(ENV.fetch("EXPORT_PATH"), REPO_ROOT)
    key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID")
    UI.user_error!("Missing App Store Connect key ID or issuer ID") if key_id.empty? || issuer_id.empty?
    UI.user_error!("Invalid App Store Connect key ID") unless key_id.match?(/\A[A-Za-z0-9]+\z/)
    key_path = File.expand_path("~/.private_keys/AuthKey_#{key_id}.p8")
    UI.user_error!("Missing signed Xcode archive") unless Dir.exist?(archive)
    UI.user_error!("Missing Xcode export options") unless File.file?(export_options)
    UI.user_error!("Missing App Store Connect private key") unless File.file?(key_path)
    sh("xcodebuild", "-exportArchive", "-archivePath", archive,
      "-exportOptionsPlist", export_options, "-exportPath", export_path,
      "-allowProvisioningUpdates", "-authenticationKeyPath", key_path,
      "-authenticationKeyID", key_id, "-authenticationKeyIssuerID", issuer_id)
  end

  desc "Submit an exact uploaded build to the Discord Users TestFlight group with its test notes"
  lane :distribute_testflight do |options|
    require File.join(REPO_ROOT, "fastlane", "lib", "testflight_distribution")
    require "spaceship"
    version = (options[:version] || ENV["RELEASE_VERSION"]).to_s
    build_number = (options[:build_number] || ENV["IOS_BUILD_NUMBER"]).to_s
    notes = BoardseshTestflightDistribution.read_notes(options[:notes_path] || ENV["TESTFLIGHT_NOTES_PATH"], root: REPO_ROOT)
    BoardseshTestflightDistribution.validate_inputs!(version: version, build_number: build_number, notes: notes)
    api_key = asc_api_key
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    receipt = BoardseshTestflightDistribution::Runner.new(
      app: app, version: version, build_number: build_number, notes: notes,
      find_builds: -> { Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version, build_number: build_number, platform: "IOS") },
      distribute: ->(distribution_options) { upload_to_testflight(api_key: api_key, **distribution_options) }
    ).run
    summary = BoardseshTestflightDistribution.summary(receipt)
    UI.success(summary)
    emit_step_summary(summary)
    receipt
  rescue BoardseshTestflightDistribution::Error => error
    UI.user_error!(error.message)
  end

  desc "Plan or submit the exact reviewed app/CPP snapshot without changing store content"
  lane :review_submission do |options|
    require File.join(REPO_ROOT, "fastlane", "lib", "store_review_submission")
    require "spaceship"
    selected = (options[:surfaces] || "default").to_s.split(",").map(&:strip)
    manifest = JSON.parse(File.read(File.join(REPO_ROOT, "app-stores", "apple", "custom-product-pages.json")))
    BoardseshStoreReview::Runner.validate_selection!(
      selected: selected, manifest: manifest, cpp_review_context_version_id: ENV["CPP_REVIEW_CONTEXT_VERSION_ID"]
    )
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App not found for review submission") unless app
    client = BoardseshStoreReview::Client.new(token: -> { Spaceship::ConnectAPI.token.refresh! if Spaceship::ConnectAPI.token.expired?; Spaceship::ConnectAPI.token.text })
    audit = -> do
      BoardseshStoreAudit::Apple.new(
        client: client, app_id: app.id, version: ENV.fetch("RELEASE_VERSION"),
        build_number: ENV.fetch("IOS_BUILD_NUMBER"), cpp_targets: manifest.fetch("targets").select { |target, _config| selected.include?(target) },
        locales: EXPECTED_DELIVER_LOCALES, display_types: manifest.fetch("devices").values.uniq
      ).run
    end
    # MANUAL unless asked: only the automatic merge-back submission
    # (mobile-store-submit.yml) passes release_type:AFTER_APPROVAL.
    result = BoardseshStoreReview::Runner.new(
      client: client, audit: audit, manifest: manifest, metadata_root: APPLE_METADATA_DIR, selected: selected,
      cpp_review_context_version_id: ENV["CPP_REVIEW_CONTEXT_VERSION_ID"], release_type: (options[:release_type] || "MANUAL").to_s
    ).run(action: (options[:action] || "plan").to_s, expected_sha256: ENV["REVIEW_SNAPSHOT_SHA256"])
    File.write(ENV.fetch("STORE_REVIEW_OUTPUT"), JSON.pretty_generate(result) + "\n")
    UI.success("Review #{result.fetch('action')}: snapshot #{result.fetch('snapshotSha256')}")
  rescue BoardseshStoreReview::Error, BoardseshASC::Error => error
    UI.user_error!(error.message)
  end

  desc "Read back the exact iOS release, listing text and ordered default/CPP screenshots"
  lane :audit do |options|
    require File.join(REPO_ROOT, "fastlane", "lib", "store_audit")
    manifest = JSON.parse(File.read(File.join(REPO_ROOT, "app-stores", "apple", "custom-product-pages.json")))
    # surfaces:default limits the audit to the app version itself (the automatic
    # merge-back submission's readiness check); the default audits every CPP too.
    surfaces = (options[:surfaces] || "all").to_s
    UI.user_error!("surfaces must be all or default") unless %w[all default].include?(surfaces)
    cpp_targets = surfaces == "default" ? {} : manifest.fetch("targets")
    asc_api_key
    require "spaceship"
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App not found for store audit") unless app
    client = BoardseshASC::Client.new(token: -> { Spaceship::ConnectAPI.token.refresh! if Spaceship::ConnectAPI.token.expired?; Spaceship::ConnectAPI.token.text })
    report = BoardseshStoreAudit::Apple.new(
      client: client, app_id: app.id, version: ENV.fetch("RELEASE_VERSION"),
      build_number: ENV.fetch("IOS_BUILD_NUMBER"), cpp_targets: cpp_targets,
      locales: EXPECTED_DELIVER_LOCALES, display_types: manifest.fetch("devices").values.uniq
    ).run
    BoardseshStoreAudit.write_report(ENV.fetch("STORE_AUDIT_OUTPUT"), report)
    UI.success("iOS release identity verified; audit report includes #{report.fetch('readinessIssues').length} asset readiness issue(s).")
  end

  desc "GET-only: whether one iOS version can be submitted now (pending, done, deferred, blocked, superseded)"
  lane :submission_status do
    require File.join(REPO_ROOT, "fastlane", "lib", "store_submission_status")
    version = ENV.fetch("RELEASE_VERSION")
    asc_api_key
    require "spaceship"
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App #{APP_IDENTIFIER} not found on App Store Connect") unless app
    client = BoardseshASC::Client.new(token: -> { Spaceship::ConnectAPI.token.refresh! if Spaceship::ConnectAPI.token.expired?; Spaceship::ConnectAPI.token.text })
    status = BoardseshStoreSubmissionStatus.ios(client.list("/v1/apps/#{app.id}/appStoreVersions?filter[platform]=IOS&limit=200"), version)
    File.write(ENV.fetch("STORE_SUBMISSION_STATUS_OUTPUT"), JSON.pretty_generate(status) + "\n")
    UI.message("iOS #{version}: #{status.fetch('status')}. #{status.fetch('reason')}")
  rescue BoardseshStoreSubmissionStatus::Error, BoardseshASC::Error => error
    UI.user_error!(error.message)
  end

  desc "Plan, create empty drafts, stage assets, upload, or submit board-specific custom product pages"
  lane :cpp do |options|
    require File.join(REPO_ROOT, "fastlane", "lib", "custom_product_pages")
    require "spaceship"
    action = (options[:action] || "plan").to_s
    target = (options[:target] || "all").to_s
    UI.user_error!("CPP action must be plan, create, stage-assets, upload, or submit") unless %w[plan create stage-assets upload submit].include?(action)
    manifest_bytes = File.read(File.join(REPO_ROOT, "app-stores", "apple", "custom-product-pages.json"))
    manifest = JSON.parse(manifest_bytes)
    retained_source = {
      receipt_path: ENV.fetch("ASC_CPP_RETAINED_RECEIPT", ""), expected_sha256: ENV.fetch("ASC_CPP_RETAINED_RECEIPT_SHA256", ""),
      capture_contract_ref: ENV.fetch("ASC_CPP_CAPTURE_CONTRACT_REF", ""), replay_run_id: ENV.fetch("ASC_CPP_RETAINED_REPLAY_RUN_ID", "")
    }
    if retained_source.values.any? { |value| !value.empty? }
      UI.user_error!("Retained CPP source is restricted to one stage-assets target") unless action == "stage-assets" && target != "all"
      BoardseshCPP.verify_retained_source(repo_root: REPO_ROOT, manifest: manifest, target: target, **retained_source)
    else
      retained_source = nil
    end
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App #{APP_IDENTIFIER} not found on App Store Connect") unless app
    keyword_mapping_json = ENV.fetch("ASC_CPP_KEYWORD_IDS_JSON", "{}").strip
    keyword_ids = %w[create stage-assets].include?(action) ? {} : JSON.parse(keyword_mapping_json.empty? ? "{}" : keyword_mapping_json)
    client = BoardseshCPP::Client.new(token: -> { Spaceship::ConnectAPI.token.refresh! if Spaceship::ConnectAPI.token.expired?; Spaceship::ConnectAPI.token.text })
    results = BoardseshCPP::Runner.new(
      client: client, repo_root: REPO_ROOT, manifest: manifest, manifest_sha256: Digest::SHA256.hexdigest(manifest_bytes), app_id: app.id,
      keyword_ids: keyword_ids, retained_source: retained_source, log: ->(message) { UI.message(message) }
    ).run(target: target, action: action)
    results.each do |result|
      line = "CPP #{result.fetch('target')}: #{result.fetch('action')} | #{result['state'] || 'new page'} | #{result['url'] || 'URL available after creation'}"
      UI.message(line)
      emit_step_summary(line)
      if action == "plan"
        UI.message("CPP_PLAN_JSON #{JSON.generate(result)}")
        result.fetch("diagnostics").each { |diagnostic| emit_step_summary("- #{result.fetch('target')}: #{diagnostic}") }
      end
      if action == "create"
        UI.message("CPP_CREATE_JSON #{JSON.generate(result)}")
        emit_step_summary("#{result.fetch('referenceName')} | app #{result.fetch('appId')} | page #{result.fetch('pageId')} | #{result.fetch('publication')}")
      end
      emit_step_summary(result.fetch("publication")) if action == "stage-assets"
    end
    plan_output = ENV["ASC_CPP_PLAN_OUTPUT"]
    File.write(plan_output, JSON.pretty_generate(results) + "\n") if action == "plan" && plan_output && !plan_output.empty?
    create_output = ENV["ASC_CPP_CREATE_OUTPUT"]
    File.write(create_output, JSON.pretty_generate(results) + "\n") if action == "create" && create_output && !create_output.empty?
  rescue BoardseshCPP::Error, JSON::ParserError, KeyError => error
    UI.user_error!(error.message)
  end

  desc "Upload App Store screenshots to App Store Connect (no binary, no metadata, no review)"
  lane :screenshots do
    manifest = screenshot_manifest

    staging_dir = Dir.mktmpdir("asc-screenshots-")
    begin
      manifest.each do |locale, devices|
        locale_dir = File.join(staging_dir, locale)
        FileUtils.mkdir_p(locale_dir)
        staged_count = 0
        devices.each do |device_slug, pngs|
          pngs.each do |png|
            FileUtils.cp(png, File.join(locale_dir, staged_filename(device_slug, png)))
            staged_count += 1
          end
        end
        UI.message("Staged #{staged_count} screenshot(s) into #{locale_dir}")
      end

      api_key = app_store_connect_api_key(
        key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
        issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
        key_filepath: ENV.fetch("ASC_KEY_PATH"),
        # ASC_KEY_PATH is a real .p8 file on disk (decoded in CI), not base64 content.
        is_key_content_base64: false,
        in_house: false
      )

      # Same pre-flight as the `metadata` lane (see its comment above `upload_to_app_store`
      # there): deliver (sync_screenshots: true) can only attach screenshots to the
      # *editable* App Store version, and between releases there's often nothing editable.
      # Without this guard the upload grinds through deliver's ~20-minute "Cannot find edit
      # app store version" backoff ladder AFTER the ~30-minute capture matrix has already run
      # — wasted either way, but at least this saves the finalize step itself.
      unless editable_app_store_version_present?
        UI.important("No editable App Store version in 'Prepare for Submission' — nothing for deliver to attach screenshots to. Skipping the upload; re-run once a version is editable.")
        emit_step_summary("**Skipped:** no editable App Store version — no iOS screenshots uploaded.")
        next
      end

      with_upload_retries do
        upload_to_app_store(
          api_key: api_key,
          app_identifier: "com.boardsesh.app",
          screenshots_path: staging_dir,
          skip_binary_upload: true,
          skip_metadata: true,
          skip_app_version_update: true,
          overwrite_screenshots: true,
          sync_screenshots: true,
          submit_for_review: false,
          run_precheck_before_submit: false,
          # force: true is mandatory in CI — without it deliver opens an HTML
          # preview in a browser and blocks until timeout.
          force: true
        )
      end
    ensure
      FileUtils.remove_entry(staging_dir) if staging_dir && Dir.exist?(staging_dir)
    end
  end

  desc "Upload App Store listing text + What's New to the editable version (no binary, no screenshots, no review)"
  lane :metadata do |options|
    expected_version = options[:expected_version].to_s
    unless expected_version.empty? || expected_version.match?(/\A\d+\.\d+\.\d+\z/)
      UI.user_error!("expected_version must be x.y.z")
    end
    # asc_api_key also sets Spaceship::ConnectAPI.token (set_spaceship_token
    # defaults to true), which the editable-version pre-flight below relies on.
    api_key = asc_api_key

    # deliver edits whichever version is editable, whatever app.config.ts says.
    # The automatic merge-back submission names the version it is about to submit,
    # and this refuses unless that exact version is the one deliver would edit.
    # Nothing editable means it is already submitted or in a review draft (deliver
    # cannot edit either), so that is a skip, not a failure: a rerun stays green.
    unless expected_version.empty?
      edit_version = editable_app_store_version
      UI.user_error!("Could not read the editable App Store version; not pushing listing text.") if edit_version == :unknown
      if edit_version.nil?
        UI.important("No editable App Store version (#{expected_version} may already be submitted or in a review draft); not pushing listing text.")
        emit_step_summary("**Skipped:** no editable App Store version #{expected_version}; listing text not pushed.")
        next
      end
      unless edit_version.version_string == expected_version
        UI.user_error!("The editable App Store version is #{edit_version.version_string}, expected #{expected_version}; not pushing listing text.")
      end
    end

    # deliver (skip_app_version_update: true) can only write listing text onto the
    # *editable* App Store version — the one in "Prepare for Submission" (or a
    # rejected state). Between releases there is often nothing editable: the live
    # version is Ready for Distribution and no new version has been created. In that
    # state deliver retries "Cannot find edit app store version" through a ~20-minute
    # backoff ladder and then fails — which used to burn the whole metadata job's
    # time budget. Skip cleanly when there's nothing to edit; the text lands on the
    # next run once a version is editable (and it's pushed again at release time).
    unless editable_app_store_version_present?
      UI.important("No editable App Store version in 'Prepare for Submission' — nothing for deliver to edit. Skipping the listing-text upload; it will be pushed once a version is editable.")
      emit_step_summary("**Skipped:** no editable App Store version — no iOS listing text uploaded.")
      next
    end

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      metadata_path: APPLE_METADATA_DIR,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      # Only edit the current editable version's text; never create or retitle a version.
      skip_app_version_update: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      # force: true — same reason as the screenshots lane: no interactive HTML preview in CI.
      force: true
    )
  end

  desc "Print the next iOS build number (latest TestFlight build for this marketing version + 1)"
  lane :next_build_number do
    fallback = ENV["BUILD_NUMBER_FALLBACK"].to_s
    number =
      begin
        latest = latest_testflight_build_number(
          api_key: asc_api_key,
          app_identifier: APP_IDENTIFIER,
          version: mobile_app_version,
          # Returned when this version has no builds yet, so a fresh train starts at 1.
          initial_build_number: 0
        )
        latest.to_i + 1
      rescue => error
        # Covers both a failed ASC query and missing credentials (asc_api_key's
        # ENV.fetch raises here too, since it's evaluated inside this begin).
        UI.important("Could not resolve the build number from App Store Connect: #{error.message}")
        UI.user_error!("No build number from App Store Connect and BUILD_NUMBER_FALLBACK is unset.") if fallback.empty?
        UI.important("Falling back to BUILD_NUMBER_FALLBACK=#{fallback}")
        fallback.to_i
      end

    UI.success("iOS build number: #{number}")
    emit_ci_output(number)
    number
  end

  desc "Prepare a DRAFT App Store version for one exact tagged release build (no review submission)"
  lane :draft_submission do
    api_key = asc_api_key
    version = ENV.fetch("RELEASE_VERSION")
    build_number = ENV.fetch("IOS_BUILD_NUMBER")
    UI.user_error!("Invalid RELEASE_VERSION: #{version}") unless version.match?(/^\d+\.\d+\.\d+$/)
    UI.user_error!("Invalid IOS_BUILD_NUMBER: #{build_number}") unless build_number.match?(/^\d+$/) && build_number.to_i.positive?

    require "spaceship"
    require File.join(REPO_ROOT, "fastlane", "lib", "asc_client")
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App #{APP_IDENTIFIER} not found on App Store Connect") if app.nil?

    # Draft only once every other version is out (see
    # OPEN_APP_STORE_VERSION_STATES), so deliver never renames one. Read straight
    # from the API with that state list, so the guard does not depend on which
    # states deliver's own lookup treats as editable. The workflow step is
    # continue-on-error and warns.
    client = BoardseshASC::Client.new(token: -> { Spaceship::ConnectAPI.token.refresh! if Spaceship::ConnectAPI.token.expired?; Spaceship::ConnectAPI.token.text })
    other_open = other_open_app_store_versions(
      client.list("/v1/apps/#{app.id}/appStoreVersions?filter[platform]=IOS&limit=200"), version
    )
    unless other_open.empty?
      UI.user_error!("App Store Connect already has an unreleased iOS version #{other_open.join(', ')}. Refusing to draft #{version} until it is out. An editable version would be renamed to #{version} by deliver; an approved one has to be released before the next version is drafted. Release, submit or remove it, then re-run this draft.")
    end

    # Create the App Store version if it doesn't exist, leaving it in 'Prepare
    # for Submission' (a DRAFT). No screenshots/metadata here (owned by the
    # screenshots/metadata lanes); crucially submit_for_review: false, so a human
    # reviews and hits Submit — we never auto-submit.
    #
    # deliver only selects a build from inside submit_for_review
    # (deliver/runner.rb → submit_for_review → select_build), which we never
    # call, so `build_number` is inert here: this call ensures the version and
    # nothing else. The build is attached below with the same Spaceship calls
    # deliver's select_build makes.
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: version,
      build_number: build_number,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      # force: true — no interactive HTML preview in CI (same as the other lanes).
      force: true
    )

    # The workflow_run trigger fires the moment the TestFlight upload returns,
    # usually 10–40 minutes before App Store Connect finishes processing the
    # build, and an unprocessed build cannot be attached. Wait for THIS build
    # (app_version + build_version, select_latest: false), bounded so a build
    # Apple never processes fails the job instead of hanging it. The ios job's
    # timeout-minutes in mobile-store-draft.yml must stay above this bound.
    build = FastlaneCore::BuildWatcher.wait_for_build_processing_to_be_complete(
      app_id: app.id,
      platform: Spaceship::ConnectAPI::Platform::IOS,
      app_version: version,
      build_version: build_number,
      poll_interval: 30,
      timeout_duration: 45 * 60,
      return_when_build_appears: false,
      return_spaceship_testflight_build: false,
      select_latest: false
    )
    unless build && build.app_version == version && build.version == build_number
      UI.user_error!("App Store Connect returned build #{build&.app_version} (#{build&.version}) while waiting for #{version} (#{build_number}); refusing to attach the wrong build.")
    end

    # Attach the processed build to the editable version — until this happens
    # the draft is a draft of nothing. Mirrors deliver's select_build:
    # App#get_edit_app_store_version + AppStoreVersion#select_build. If the
    # editable version is not the one just ensured (a stale draft of another
    # version still open), refuse rather than attach to it.
    edit_version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    if edit_version.nil? || edit_version.version_string != version
      UI.user_error!("Editable App Store version is #{edit_version&.version_string || 'none'}, expected #{version}; not attaching build #{build_number}.")
    end
    edit_version.select_build(build_id: build.id)
    UI.success("Prepared a draft App Store version #{version} with build #{build_number} attached.")
  end

  desc "Read Apple creative specs, plan, upload, or assign reviewed creative assets"
  lane :creatives do |options|
    require File.join(REPO_ROOT, "fastlane", "lib", "creative_assets")
    require "spaceship"
    action = (options[:action] || "plan").to_s
    variant = (options[:variant] || "all").to_s
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App #{APP_IDENTIFIER} not found on App Store Connect") unless app
    client = BoardseshASC::Client.new(token: -> { Spaceship::ConnectAPI.token.refresh! if Spaceship::ConnectAPI.token.expired?; Spaceship::ConnectAPI.token.text })
    results = BoardseshCreatives::Runner.new(
      client: client, repo_root: REPO_ROOT, app_id: app.id,
      manifest: JSON.parse(File.read(File.join(REPO_ROOT, "app-stores", "apple", "creative-assets.json"))),
      cpp_manifest: JSON.parse(File.read(File.join(REPO_ROOT, "app-stores", "apple", "custom-product-pages.json")))
    ).run(action: action, variant: variant, allow_live: options[:allow_live].to_s == "true", allow_replace: options[:allow_replace].to_s == "true")
    UI.message(JSON.pretty_generate(results))
    output = ENV["ASC_CREATIVES_OUTPUT"]
    File.write(output, JSON.pretty_generate(results) + "\n") if output && !output.empty?
    emit_step_summary("Creative assets: #{action}, #{variant}; asset review and ASC Preview remain required.")
  rescue BoardseshCreatives::Error, JSON::ParserError, KeyError => error
    UI.user_error!(error.message)
  end
end

platform :android do
  desc "Upload one built AAB to internal and open testing in one review-protected edit"
  lane :upload_beta do |options|
    require File.join(REPO_ROOT, "fastlane", "lib", "android_release")
    aab_pattern = options[:aab] || ENV.fetch("ANDROID_AAB_PATH")
    aabs = Dir.glob(File.expand_path(aab_pattern, REPO_ROOT))
    UI.user_error!("Expected exactly one AAB matching the upload path") unless aabs.length == 1
    version_code = options[:version_code] || ENV.fetch("ANDROID_VERSION_CODE")
    version = options[:version] || ENV.fetch("BOARDSESH_MOBILE_VERSION")
    metadata_path = File.expand_path(options[:metadata_path] || ANDROID_METADATA_DIR, REPO_ROOT)
    credential = ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"] || ENV["GOOGLE_PLAY_JSON_KEY"]
    service = -> { BoardseshAndroidRelease.service(json_key_data: credential) }
    report = BoardseshAndroidRelease::Runner.new(service: service, aab: aabs.first,
      version_code: version_code, version: version, metadata_path: metadata_path).run
    UI.message(JSON.pretty_generate(report))
    File.write(options[:output], JSON.pretty_generate(report) + "\n") if options[:output]
  rescue BoardseshAndroidRelease::Error => error
    UI.user_error!(error.message)
  end

  desc "Audit exact Android release lifecycle without creating a Play edit"
  lane :audit do |options|
    ENV["ANDROID_VERSION_CODE"] = (options[:version_code] || ENV.fetch("ANDROID_VERSION_CODE")).to_s
    ENV["ANDROID_TRACK"] = (options[:track] || "beta").to_s
    ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"] ||= ENV["GOOGLE_PLAY_JSON_KEY"]
    ENV["STORE_AUDIT_OUTPUT"] = options[:output] || File.join(Dir.mktmpdir("play-audit-"), "audit.json")
    Dir.chdir(REPO_ROOT) do
      sh("vp", "exec", "node", "--import", "tsx", File.join(REPO_ROOT, "scripts", "mobile-store-android-audit.ts"))
    end
    UI.message("Release lifecycle receipt: #{ENV.fetch('STORE_AUDIT_OUTPUT')}")
  end

  desc "Plan or submit one exact published internal build to open testing (beta)"
  lane :beta do |options|
    version_code = (options[:version_code] || ENV["ANDROID_VERSION_CODE"]).to_s
    unless version_code.match?(/\A[1-9]\d*\z/)
      UI.user_error!("Provide version_code:<exact Android versionCode>")
    end
    ENV["ANDROID_VERSION_CODE"] = version_code
    ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"] ||= ENV["GOOGLE_PLAY_JSON_KEY"]
    command = ["vp", "exec", "node", "--import", "tsx", File.join(REPO_ROOT, "scripts", "mobile-store-android-beta.ts")]
    command << "--apply" if options[:apply].to_s == "true"
    Dir.chdir(REPO_ROOT) { sh(*command) }
  end

  desc "Plan or release one exact published internal build to production (rollout 1-100, default 100)"
  lane :production do |options|
    version_code = (options[:version_code] || ENV["ANDROID_VERSION_CODE"]).to_s
    unless version_code.match?(/\A[1-9]\d*\z/)
      UI.user_error!("Provide version_code:<exact Android versionCode>")
    end
    rollout = (options[:rollout] || ENV["ANDROID_ROLLOUT_PERCENT"] || "100").to_s
    unless rollout.match?(/\A(100|[1-9]\d?)\z/)
      UI.user_error!("rollout must be a whole percent from 1 to 100")
    end
    ENV["ANDROID_VERSION_CODE"] = version_code
    ENV["ANDROID_ROLLOUT_PERCENT"] = rollout
    ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"] ||= ENV["GOOGLE_PLAY_JSON_KEY"]
    command = ["vp", "exec", "node", "--import", "tsx", File.join(REPO_ROOT, "scripts", "mobile-store-android-production.ts")]
    command << "--apply" if options[:apply].to_s == "true"
    Dir.chdir(REPO_ROOT) { sh(*command) }
  end

  desc "Upload Play Store phone screenshots to Google Play (no binary, no text metadata)"
  lane :screenshots do
    unless Dir.exist?(GOOGLE_SCREENSHOTS_DIR)
      UI.user_error!("No screenshots directory at #{GOOGLE_SCREENSHOTS_DIR}. Run `vp run mobile:screenshots -- --platform android` first.")
    end

    pngs = Dir.glob(File.join(GOOGLE_SCREENSHOTS_DIR, "*.png")).sort
    if pngs.length < 2
      UI.user_error!("Found #{pngs.length} PNG(s) in #{GOOGLE_SCREENSHOTS_DIR}. Refusing to upload fewer than 2 Play phone screenshots.")
    end
    if pngs.length > 8
      UI.user_error!("Found #{pngs.length} PNG(s) in #{GOOGLE_SCREENSHOTS_DIR}. Google Play accepts at most 8 phone screenshots.")
    end

    staging_dir = Dir.mktmpdir("play-screenshots-")
    begin
      metadata_dir = File.join(staging_dir, "android")
      phone_dir = File.join(metadata_dir, SUPPLY_LOCALE, "images", "phoneScreenshots")
      FileUtils.mkdir_p(phone_dir)
      pngs.each { |png| FileUtils.cp(png, File.join(phone_dir, File.basename(png))) }
      UI.message("Staged #{pngs.length} Play phone screenshot(s) into #{phone_dir}")

      # Synced by SHA-256 like supply's sync_image_upload, so an unchanged set is a
      # no-op. One review-protected commit: a pending review fails the upload
      # instead of being cancelled. No automatic retry: rerunning reconciles.
      push_play_listing(parts: ["screenshots"], metadata_path: metadata_dir)
    ensure
      FileUtils.remove_entry(staging_dir) if staging_dir && Dir.exist?(staging_dir)
    end
  end

  # The listing lanes commit with changesNotSentForReview=false and never retry
  # with it set to true. Google rejects some listing-only edits with "Please set
  # the query parameter changesNotSentForReview to true"; supply's default rescue
  # used to recommit that silently, leaving the change in the Play Console as
  # "ready to send for review" while CI showed green (why the live listing once
  # kept the old icon and copy). A failure there is the signal to send it by hand.
  desc "Upload Play Store listing text (title + short/full description) — no binary, no changelog, no images"
  lane :metadata do
    # "What's new" ships with the AAB at release time (upload_beta reads
    # changelogs/default.txt), so release notes are not touched here.
    push_play_listing(parts: ["listing"])
  end

  desc "Upload Play Store listing images (high-res icon, feature graphic) — no binary, no text, no screenshots"
  lane :images do
    # Uploads the images present under <locale>/images/ (icon.png 512x512,
    # featureGraphic.png 1024x500). Each upload replaces that one image type and
    # leaves the others alone; phone screenshots belong to the screenshots lane.
    push_play_listing(parts: ["images"])
  end

  desc "Print the next Android versionCode (sideload floor raised to the Play ceiling, never below it)"
  lane :next_version_code do
    # VERSION_CODE_FALLBACK is the deterministic sideload line: offset (2_000_000)
    # + github.run_number, set by android-apk-rn.yml. It is the versionCode that
    # historically shipped on every public sideload APK and is preserved for the
    # private diagnostic artifacts, so it remains the live upgrade ceiling for
    # devices that installed that channel — currently ~2_000_2xx.
    #
    # It is a FLOOR, not a "fallback". The Google Play internal track sits in the
    # low hundreds (it started fresh from the bootstrap upload), so deriving the
    # shared versionCode from Play alone drags it far BELOW the sideload ceiling:
    # build 285 shipped 2_000_285, then build 289 (which first read Play) shipped
    # 190, and Android then rejects every sideload upgrade with
    # INSTALL_FAILED_VERSION_DOWNGRADE (190 < 2_000_285). The Play query may only
    # RAISE the number above this floor, never lower it. See
    # docs/android-sideload-build.md.
    fallback = ENV["VERSION_CODE_FALLBACK"].to_s
    floor = fallback.empty? ? nil : fallback.to_i

    json_key_data = ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"].to_s
    play_next =
      begin
        # No service account yet (first-upload bootstrap) -> floor only.
        UI.user_error!("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON is empty.") if json_key_data.empty?
        codes = []
        %w[production beta alpha internal].each do |track|
          begin
            codes.concat(
              Array(
                google_play_track_version_codes(
                  package_name: APP_IDENTIFIER,
                  json_key_data: json_key_data,
                  track: track
                )
              )
            )
          rescue => track_error
            # An empty/non-existent track (e.g. no alpha) is expected — skip it.
            UI.important("Could not read '#{track}' track: #{track_error.message}")
          end
        end
        UI.user_error!("No version codes on any track.") if codes.empty?
        codes.map(&:to_i).max + 1
      rescue => error
        UI.important("google_play_track_version_codes failed: #{error.message}")
        nil
      end

    # max(sideload floor, Play ceiling + 1). Keeps every sideload upgrade valid
    # while staying strictly above whatever Play already has, so the AAB uploads
    # cleanly too. Errors only when BOTH inputs are missing.
    code = [floor, play_next].compact.max
    UI.user_error!("No version code: Google Play query returned nothing and VERSION_CODE_FALLBACK is unset.") if code.nil?

    if floor && play_next && play_next > floor
      UI.important("Play ceiling (#{play_next}) is above the sideload floor (#{floor}); using #{code}.")
    elsif floor && play_next
      UI.important("Play ceiling (#{play_next}) is at/below the sideload floor (#{floor}); holding the floor at #{code}.")
    end

    UI.success("Android versionCode: #{code}")
    emit_ci_output(code)
    code
  end

  desc "Prepare a DRAFT production release for one exact tagged build (no review submission, no rollout)"
  lane :draft_submission do
    version = ENV.fetch("RELEASE_VERSION")
    version_code = ENV.fetch("ANDROID_VERSION_CODE")
    UI.user_error!("Invalid RELEASE_VERSION: #{version}") unless version.match?(/^\d+\.\d+\.\d+$/)
    UI.user_error!("Invalid ANDROID_VERSION_CODE: #{version_code}") unless version_code.match?(/^\d+$/) && version_code.to_i.positive?
    ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"] ||= ENV["GOOGLE_PLAY_JSON_KEY"]

    # Copies the exact internal-track release (uploaded by android-apk-rn.yml) to
    # production as a draft, in one edit committed with ERROR_IF_IN_REVIEW, so it
    # can never cancel a review. Never sent for review and never rolled out: the
    # merge-back submission (mobile-store-submit.yml) or Android Production Release
    # does that. No AAB upload, no text, images or screenshots.
    Dir.chdir(REPO_ROOT) do
      sh("vp", "exec", "node", "--import", "tsx", File.join(REPO_ROOT, "scripts", "mobile-store-android-draft.ts"))
    end
    UI.success("Prepared a draft production release for versionCode #{version_code}, from internal.")
  end
end
