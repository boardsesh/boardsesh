# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
coverage
packages/web/playwright-report
packages/web/test-results
packages/web/e2e/screenshots/

# next.js
.next/
out/

# production
build
dist
.docker-context/

# misc
.DS_Store
*.pem
# Self-hosted OTA code signing: the public certificate is committed so the app
# can verify update signatures; the private/public signing keys stay server-only.
!packages/mobile/certs/certificate.pem
packages/mobile/certs/private-key.pem
packages/mobile/certs/public-key.pem
/tmp/

# debug
npm-debug.log*
.pnpm-debug.log*

# pnpm's content-addressable store when a project-local storeDir is used.
.pnpm-store/
yarn-debug.log*
yarn-error.log*

# Performance traces
*.trace.json.gz

# local env files
.env*.local
!.env.local
.env.development.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
kilter.db
tension.db
**/db/tmp

# editor
.vscode

# Embedded firmware (PlatformIO)
embedded/**/.pio
embedded/**/.vscode
!embedded/**/.vscode/extensions.json

# Generated GraphQL types (regenerated from schema during build)
embedded/libs/graphql-types/src/graphql_types.h
embedded/libs/graphql-types/.schema_hash

# Generated board data (regenerated by generate-board-data.mjs during build)
embedded/libs/board-data/src/board_image_data.h
embedded/libs/board-data/src/board_data.cpp
embedded/libs/board-data/src/board_hold_data.h
embedded/libs/board-data/.board_data_hash

# backend
packages/backend/dist

# shared-schema
packages/shared-schema/dist

# user uploads (local development)
packages/web/public/uploads
!packages/web/public/uploads/.gitkeep
.env.sentry-build-plugin


# generated API documentation
packages/web/public/openapi.json

# static Expo web export served at /app (scripts/build-expo-web-export.sh)
packages/web/public/app
# standalone Expo web export for app.boardsesh.com (--subdomain, baseUrl /)
packages/web/public/app-standalone
.claude/settings.local.json
packages/db/docker/tmp/g
packages/db/docker/tmp/

# local environment variables
.env.local
.boardsesh/
eng.traineddata

# React Native / Expo
packages/mobile/.env
packages/mobile/.expo/
packages/mobile/ios/
packages/mobile/android/
# Native-module gradle/cmake build cache from `expo run:android` (the module's
# android/ source is tracked, but these generated dirs must not be).
packages/mobile/modules/**/android/.cxx/
packages/mobile/modules/**/android/build/
packages/mobile/modules/**/android/.gradle/
packages/mobile/dist/
packages/mobile/.bundle-check-output/
# Prebuilt simulator dev-client .app for the screenshots pipeline (CI-cached).
packages/mobile/.app-cache/
.claude/worktrees/

# Local analysis workspace (out-of-tree artifacts, not source)
.local-work/

# Apple App Store screenshots are captured fresh by the Maestro pipeline
# (vp run mobile:screenshots) and uploaded on demand — not committed.
/app-stores/apple/screenshots/
# Google Play screenshots ARE committed: app-stores/google/screenshots/pixel-2/
# is the source of truth the Mobile Store Metadata workflow uploads, refreshed by
# mobile-screenshots-android.yml's commit-back. (Apple stays ephemeral because
# deliver routes its many device sizes by pixel dimensions at upload time.)

# fastlane — never commit credentials or generated run artifacts.
*.p8
AuthKey_*.p8
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
.vscode/settings.json

# Local-only board-data exports (e.g. the MoonBoard 2024 problems JSON). Large
# raw data files are imported via the db CLIs, never committed to the repo.
packages/db/data/

# Climb2Vec offline training artifacts (never commit extracts/venv/models)
ml/climb2vec/data/
ml/climb2vec/.venv/
ml/climb2vec/artifacts/

# Python bytecode
__pycache__/
*.pyc

# Garmin Connect IQ (Monkey C) watch app — build artifacts + developer key.
# The developer key signs local/simulator builds; never commit it. Build
# products (.prg / .iq) regenerate from source via monkeyc.
garmin/bin/
garmin/**/*.prg
garmin/**/*.iq
garmin/**/*.iq.debug.xml
garmin/developer_key
garmin/developer_key.der
garmin/developer_key.pem
