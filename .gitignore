# dependencies
node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
bun-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
!.env.local
.env.development.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
kilter.db
tension.db
**/db/tmp

# editor
.vscode

# Embedded firmware (PlatformIO)
embedded/**/.pio
embedded/**/.vscode
