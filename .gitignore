# Generated GraphQL types (regenerated from schema during build)
embedded/libs/graphql-types/src/graphql_types.h
embedded/libs/graphql-types/.schema_hash

# Generated board data (regenerated by generate-board-data.mjs during build)
embedded/libs/board-data/src/board_image_data.h
embedded/libs/board-data/src/board_data.cpp
embedded/libs/board-data/src/board_hold_data.h
embedded/libs/board-data/.board_data_hash

# spa (TanStack Start / Nitro)
packages/spa/.output
packages/spa/.vinxi

# backend
packages/backend/dist

# shared-schema
packages/shared-schema/dist

# user uploads (local development)
packages/web/public/uploads
!packages/web/public/uploads/.gitkeep
.env.sentry-build-plugin

# generated API documentation
packages/web/public/openapi.json
