{
  "name": "boardsesh-backend",
  "version": "1.0.0",
  "description": "WebSocket backend for Boardsesh Party Mode",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_ENV=development DOTENV_CONFIG_PATH=.env.development tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "test": "vp test",
    "test:run": "vp test run",
    "test:coverage": "vp test run --coverage",
    "lint": "vp lint",
    "lint-fix": "vp lint --fix",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:db:migrate": "DATABASE_URL=postgresql://postgres:postgres@localhost:5433/boardsesh_backend_test drizzle-kit migrate",
    "test:integration": "vp test run src/__tests__/integration.test.ts",
    "test:redis": "vp test run src/__tests__/redis-pubsub.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@boardsesh/aurora-sync": "*",
    "@boardsesh/board-art-geometry": "*",
    "@boardsesh/board-config": "*",
    "@boardsesh/board-constants": "*",
    "@boardsesh/board-layers": "*",
    "@boardsesh/board-render": "*",
    "@boardsesh/board-renderer-wasm": "*",
    "@boardsesh/crypto": "*",
    "@boardsesh/db": "*",
    "@boardsesh/email": "*",
    "@boardsesh/graphql": "*",
    "@boardsesh/gym-claim": "*",
    "@boardsesh/kilter-sync": "*",
    "@boardsesh/kiosk": "*",
    "@boardsesh/offline-sync": "*",
    "@boardsesh/pr-body": "*",
    "@boardsesh/quantum-sync": "*",
    "@boardsesh/queue": "*",
    "@boardsesh/shared-schema": "*",
    "@boardsesh/sync-runtime": "*",
    "@boardsesh/text-redaction": "*",
    "@escape.tech/graphql-armor-cost-limit": "^2.4.3",
    "@escape.tech/graphql-armor-max-depth": "^2.4.2",
    "@graphql-tools/schema": "^10.0.38",
    "@noble/curves": "^2.0.1",
    "@panva/hkdf": "^1.2.1",
    "@parse/node-apn": "^8.1.0",
    "@sentry/node": "^10.69.0",
    "@whatwg-node/fetch": "^0.10.13",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.2",
    "graphql-type-json": "^0.3.2",
    "graphql-ws": "^6.2.0",
    "graphql-yoga": "^5.21.2",
    "ioredis": "^5.11.1",
    "jose": "^6.2.6",
    "nodemailer": "^9.0.3",
    "posthog-node": "^5.47.3",
    "sharp": "^0.34.5",
    "tsx": "^4.23.1",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@boardsesh/graphql-client": "*",
    "@boardsesh/queue-react": "*",
    "@boardsesh/queue-runtime": "*",
    "@types/busboy": "^1.5.4",
    "@types/node": "^25.9.5",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "postgres": "^3.4.9",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
