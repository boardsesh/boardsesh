# Generic configuration for backend development
# This file is tracked in git and should NOT contain production secrets

PORT=8080
DATABASE_URL=postgresql://postgres:password@localhost:5432/main
REDIS_URL=redis://localhost:6379

# Must match the value in packages/web/.env.local so auth token validation works
NEXTAUTH_SECRET=dev-secret-change-me

# External-platform integrations (Strava). The Strava client id/secret come
# from a Strava API application (https://www.strava.com/settings/api). Leave
# blank locally unless you're testing the OAuth flow end-to-end. BACKEND_PUBLIC_URL
# is the publicly reachable origin used to build the provider redirect URI; for
# a real Strava handshake it must match the Authorization Callback Domain on the
# Strava app and be reachable from the device (e.g. a Tailscale/ngrok URL), not
# plain localhost.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
BACKEND_PUBLIC_URL=http://localhost:8080

# Native social login (POST /auth/native/oauth) verifies Apple/Google identity
# tokens against the provider JWKS. The audience must match the client IDs the
# mobile app signs in with. Production sets these as deployment secrets; locally
# they only matter if you're testing native sign-in against this backend.
# APPLE_BUNDLE_ID defaults to com.boardsesh.app.
# APPLE_BUNDLE_ID=com.boardsesh.app
# GOOGLE_IOS_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_ANDROID_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_WEB_CLIENT_ID=...apps.googleusercontent.com

# Used to call the web service's internal revalidate routes (climb-cache
# invalidation, etc.). In production set both BOARDSESH_WEB_URL and
# REVALIDATE_SECRET as deployment secrets matching the web side. Kept
# distinct from CRON_SECRET so a leaked backend env doesn't grant access to
# other cron-triggered web routes. Local default points at the dev web
# server; REVALIDATE_SECRET stays unset for dev unless you want to test the
# auth path end-to-end.
BOARDSESH_WEB_URL=http://localhost:3000
# REVALIDATE_SECRET=

# Optional: Discord webhook URL for forwarding submitted feedback. Leave
# blank locally — production has this set as a deployment secret. To test
# end-to-end from your dev box, create a throwaway webhook in a Discord
# channel (Server Settings → Integrations → Webhooks → New Webhook → Copy
# Webhook URL) and paste it here.
DISCORD_FEEDBACK_URL=

# Sentry is initialized in src/instrument.ts with a hardcoded DSN (matches the
# web service). Sentry is gated to NODE_ENV=production, so locally it stays
# off. RAILWAY_ENVIRONMENT_NAME is set automatically by Railway and tags the
# environment in Sentry. No local override is needed unless you want to test
# against a separate Sentry project.
# SENTRY_DSN=
