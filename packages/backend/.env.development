# Generic configuration for backend development
# This file is tracked in git and should NOT contain production secrets

PORT=8080
DATABASE_URL=postgresql://postgres:password@localhost:5432/main
REDIS_URL=redis://localhost:6379

# Must match the value in packages/web/.env.local so auth token validation works
NEXTAUTH_SECRET=dev-secret-change-me

# External-platform integrations (Strava). The Strava client id/secret come
# from a Strava API application (https://www.strava.com/settings/api). Leave
# blank locally unless you're testing the OAuth flow end-to-end. BACKEND_PUBLIC_URL
# is the publicly reachable origin used to build the provider redirect URI; for
# a real Strava handshake it must match the Authorization Callback Domain on the
# Strava app and be reachable from the device (e.g. a Tailscale/ngrok URL), not
# plain localhost.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
BACKEND_PUBLIC_URL=http://localhost:8080

# Native social login (POST /auth/native/oauth) verifies Apple/Google identity
# tokens against the provider JWKS. The audience must match the client IDs the
# mobile app signs in with. Production sets these as deployment secrets; locally
# they only matter if you're testing native sign-in against this backend.
# APPLE_BUNDLE_ID defaults to com.boardsesh.app.
# APPLE_BUNDLE_ID=com.boardsesh.app
# GOOGLE_IOS_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_ANDROID_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_WEB_CLIENT_ID=...apps.googleusercontent.com

# Used to call the web service's internal revalidate routes (climb-cache
# invalidation, etc.). In production set both BOARDSESH_WEB_URL and
# REVALIDATE_SECRET as deployment secrets matching the web side. Kept
# distinct from CRON_SECRET so a leaked backend env doesn't grant access to
# other cron-triggered web routes. Local default points at the dev web
# server; REVALIDATE_SECRET stays unset for dev unless you want to test the
# auth path end-to-end.
BOARDSESH_WEB_URL=http://localhost:3000
# REVALIDATE_SECRET=

# Bug reports → GitHub issues. When a bug report is submitted the backend opens
# an issue in FEEDBACK_GITHUB_REPO (default boardsesh/boardsesh). Leave the token
# blank locally — issue creation no-ops without it. Production sets the token as a
# deployment secret; it needs `issues:write` on the repo (a fine-grained PAT scoped
# to the repo, or a classic PAT with `public_repo`). Kept separate from GITHUB_TOKEN
# (read-only, used by the OTA preview channel lister) so that token's scope isn't
# broadened. To test end-to-end from your dev box, point FEEDBACK_GITHUB_REPO at a
# throwaway repo and paste a PAT here.
FEEDBACK_GITHUB_TOKEN=
# FEEDBACK_GITHUB_REPO=boardsesh/boardsesh

# Crowdsourced QA (docs/crowdsourced-qa.md). The backend reads open PRs to serve
# test plans to testers, and writes each verdict back as a PR comment plus a
# qa-approved / qa-declined label. Unset locally: reads work anonymously (60/hr
# per IP, enough for one dev box) and the write side no-ops, so a verdict is
# still recorded in qa_verdicts. Production needs a fine-grained PAT on
# boardsesh/boardsesh with Pull requests read+write, Issues read+write, and
# Contents read — an Issues-only token 403s on PR comments and labels. Falls back
# to FEEDBACK_GITHUB_TOKEN / FEEDBACK_GITHUB_REPO when unset.
QA_GITHUB_TOKEN=
# QA_GITHUB_REPO=boardsesh/boardsesh

# Transactional email (shared @boardsesh/email, Fastmail SMTP). Used to email a
# consenting bug reporter the GitHub issue link. Leave blank locally — sending
# no-ops without SMTP_USER/SMTP_PASSWORD. Production sets these as deployment
# secrets (same Fastmail credentials the web app uses; 1Password → Boardsesh SMTP).
# SMTP_HOST=smtp.fastmail.com
# SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Sentry is initialized in src/instrument.ts with a hardcoded DSN (matches the
# web service). Sentry is gated to NODE_ENV=production, so locally it stays
# off. RAILWAY_ENVIRONMENT_NAME is set automatically by Railway and tags the
# environment in Sentry. No local override is needed unless you want to test
# against a separate Sentry project.
# SENTRY_DSN=

# Concurrent anonymous WebSocket connections per IP (websocket/connection-cap.ts,
# issue #4035). Bounds the *count* of live anonymous sockets, which the #2863
# rate limits do not touch. Authenticated users and API-key controllers are exempt.
# The per-client-IP tier enforces; the TCP-peer tier is warn-only because in the
# hosted topology that peer can be a shared Cloudflare/Railway edge address.
# The two cap values below repeat the in-code defaults, so uncommenting them
# changes nothing — override only to tune. The ENFORCE line is NOT a default:
# setting it to 1 promotes the TCP-peer tier from warn-only to rejecting, which
# is a behaviour change. See docs/websocket-implementation.md, "Anonymous
# Concurrency Cap".
# WS_ANON_CONNECTIONS_PER_CLIENT_IP=200
# WS_ANON_CONNECTIONS_PER_SOCKET_PEER=1000
# WS_ANON_CONNECTIONS_PER_SOCKET_PEER_ENFORCE=1
