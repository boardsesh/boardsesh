# Generic configuration for development
# This file is tracked in git and should NOT contain secrets

VERCEL_ENV=development
POSTGRES_URL=postgresql://postgres:password@db.localtest.me:5432/main
DATABASE_URL=postgresql://postgres:password@db.localtest.me:5432/main
BASE_URL=http://localhost:3000
POSTGRES_HOST=db.localtest.me
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=main
IRON_SESSION_PASSWORD={ "1": "dev-secret-change-me" }

# NextAuth.js configuration
NEXTAUTH_SECRET=dev-secret-change-me
NEXTAUTH_URL=http://localhost:3000

# Backend WebSocket URL
# For production, set this via your deployment platform's environment variables (e.g., Vercel)
NEXT_PUBLIC_WS_URL=ws://localhost:8080/graphql

# S3 Storage Configuration (optional, for production)
# When these are set, avatar uploads go to S3 instead of local disk
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=us-east-1
# AWS_ENDPOINT_URL=https://your-s3-endpoint.com
# AWS_S3_BUCKET_NAME=your-bucket-name

# PostHog Analytics (replaces @vercel/analytics + @vercel/speed-insights)
# The wrapper at app/lib/analytics.ts is a no-op unless the host is boardsesh.com
# AND a key is set, so leaving these unset locally is fine.
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

