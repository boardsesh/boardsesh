# Production environment configuration for Boardsesh SPA
# These values are baked into the Vite build at build time.

# Backend API URL (GraphQL HTTP endpoint)
VITE_API_URL=https://api.boardsesh.com

# Backend WebSocket URL (GraphQL WS endpoint)
VITE_WS_URL=wss://api.boardsesh.com/graphql

# Sentry DSN for error tracking (optional, leave empty to disable)
VITE_SENTRY_DSN=
