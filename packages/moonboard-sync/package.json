{
  "name": "@boardsesh/moonboard-sync",
  "version": "1.0.0",
  "description": "MoonBoard public location sync utility for Boardsesh",
  "bin": {
    "moonboard-sync": "./dist/cli/index.js"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "import": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./sync": {
      "types": "./src/sync/index.ts",
      "import": "./src/sync/index.ts",
      "default": "./src/sync/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "lint-fix": "vp lint --fix",
    "sync:locations": "tsx src/cli/index.ts locations --skip-if-missing-credentials"
  },
  "dependencies": {
    "@boardsesh/db": "*",
    "@boardsesh/location-sync": "*",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vitest": "*"
  }
}
