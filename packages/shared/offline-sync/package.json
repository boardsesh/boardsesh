{
  "name": "@boardsesh/offline-sync",
  "version": "1.0.0",
  "description": "Offline-first sync engine: durable mutation outbox + drainer, checkpointed pull sync, on-device SQLite DDL/migrations. Platform I/O (SQLite handle, connectivity, scheduler triggers, telemetry, cache invalidation) is injected.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./error-classification": {
      "types": "./src/mutation-queue/error-classification.ts",
      "import": "./src/mutation-queue/error-classification.ts",
      "default": "./src/mutation-queue/error-classification.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@boardsesh/shared-schema": "workspace:*",
    "@types/node": "^25.9.5",
    "typescript": "~7.0.2"
  }
}
