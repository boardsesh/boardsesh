{
  "name": "@boardsesh/auth-protocol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./auth-time": {
      "types": "./src/auth-time.ts",
      "import": "./src/auth-time.ts",
      "default": "./src/auth-time.ts"
    },
    "./partner-oauth": {
      "types": "./src/partner-oauth.ts",
      "import": "./src/partner-oauth.ts",
      "default": "./src/partner-oauth.ts"
    },
    "./partner-oauth-mode": {
      "types": "./src/partner-oauth-mode.ts",
      "import": "./src/partner-oauth-mode.ts",
      "default": "./src/partner-oauth-mode.ts"
    },
    "./client-errors": {
      "types": "./src/client-errors.ts",
      "import": "./src/client-errors.ts",
      "default": "./src/client-errors.ts"
    },
    "./transport": {
      "types": "./src/private-command-transport.ts",
      "import": "./src/private-command-transport.ts",
      "default": "./src/private-command-transport.ts"
    },
    "./password-hash": {
      "types": "./src/password-hash.ts",
      "import": "./src/password-hash.ts",
      "default": "./src/password-hash.ts"
    },
    "./account-email": {
      "types": "./src/account-email.ts",
      "import": "./src/account-email.ts",
      "default": "./src/account-email.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  }
}
