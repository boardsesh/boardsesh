{
  "name": "@boardsesh/auth-protocol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client-errors": {
      "types": "./src/client-errors.ts",
      "import": "./src/client-errors.ts",
      "default": "./src/client-errors.ts"
    },
    "./transport": {
      "types": "./src/private-command-transport.ts",
      "import": "./src/private-command-transport.ts",
      "default": "./src/private-command-transport.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  }
}
