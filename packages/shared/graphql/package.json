{
  "name": "@boardsesh/graphql",
  "version": "1.0.0",
  "description": "Shared GraphQL operations and codegen output for Boardsesh (web + mobile)",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./operations": {
      "types": "./src/operations/index.ts",
      "import": "./src/operations/index.ts",
      "default": "./src/operations/index.ts"
    },
    "./operations/*": {
      "types": "./src/operations/*.ts",
      "import": "./src/operations/*.ts",
      "default": "./src/operations/*.ts"
    },
    "./generated": {
      "types": "./src/generated/index.ts",
      "import": "./src/generated/index.ts",
      "default": "./src/generated/index.ts"
    },
    "./generated/*": {
      "types": "./src/generated/*.ts",
      "import": "./src/generated/*.ts",
      "default": "./src/generated/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vp test"
  },
  "dependencies": {
    "@boardsesh/shared-schema": "*",
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^16.13.0",
    "graphql-request": "^7.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
