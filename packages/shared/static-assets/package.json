{
  "name": "@boardsesh/static-assets",
  "version": "1.0.0",
  "description": "Platform-neutral catalog of immutable Boardsesh static assets",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./shell": {
      "types": "./src/generated/shell.ts",
      "import": "./src/generated/shell.ts",
      "default": "./src/generated/shell.ts"
    },
    "./catalog.json": "./src/generated/catalog.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "~7.0.2"
  }
}
