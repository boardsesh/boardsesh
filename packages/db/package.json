{
  "name": "@boardsesh/db",
  "version": "1.0.0",
  "description": "Shared database schema and client for Boardsesh",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./schema/boards": {
      "types": "./src/schema/boards/index.ts",
      "import": "./src/schema/boards/index.ts",
      "default": "./src/schema/boards/index.ts"
    },
    "./schema/auth": {
      "types": "./src/schema/auth/index.ts",
      "import": "./src/schema/auth/index.ts",
      "default": "./src/schema/auth/index.ts"
    },
    "./schema/app": {
      "types": "./src/schema/app/index.ts",
      "import": "./src/schema/app/index.ts",
      "default": "./src/schema/app/index.ts"
    },
    "./relations": {
      "types": "./src/relations/index.ts",
      "import": "./src/relations/index.ts",
      "default": "./src/relations/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./client/config": {
      "types": "./src/client/config.ts",
      "import": "./src/client/config.ts",
      "default": "./src/client/config.ts"
    },
    "./catalog-snapshot": {
      "types": "./src/catalog-snapshot.ts",
      "import": "./src/catalog-snapshot.ts",
      "default": "./src/catalog-snapshot.ts"
    },
    "./queries": {
      "types": "./src/queries/index.ts",
      "import": "./src/queries/index.ts",
      "default": "./src/queries/index.ts"
    },
    "./testing/dedup-replay": {
      "types": "./src/testing/dedup-replay.ts",
      "import": "./src/testing/dedup-replay.ts",
      "default": "./src/testing/dedup-replay.ts"
    },
    "./testing/moonboard-angle-dedup-replay": {
      "types": "./src/testing/moonboard-angle-dedup-replay.ts",
      "import": "./src/testing/moonboard-angle-dedup-replay.ts",
      "default": "./src/testing/moonboard-angle-dedup-replay.ts"
    },
    "./test-utils": {
      "types": "./src/test-utils/sql-text.ts",
      "import": "./src/test-utils/sql-text.ts",
      "default": "./src/test-utils/sql-text.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "lint-fix": "vp lint --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "tsx --test 'scripts/**/*.test.ts' 'src/**/*.test.ts'",
    "test:explain": "tsx --test src/queries/climbs/__tests__/search-climbs-explain.integration.test.ts",
    "test:migration-journal": "tsx --test scripts/migration-journal-verification.integration.test.ts",
    "db:verify-journal": "tsx scripts/verify-migration-journal.ts",
    "db:studio": "drizzle-kit studio",
    "db:import-moonboard": "tsx scripts/import-moonboard-problems.ts",
    "db:import-moonboard-2024": "tsx scripts/import-moonboard-2024.ts",
    "db:import-moonboard-catalog": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/import-moonboard-catalog.ts",
    "db:import-woods-catalog": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/import-woods-catalog.ts",
    "db:import-aurora-unified": "tsx scripts/import-aurora-board-unified.ts",
    "db:generate-moonboard-cell-sets": "tsx scripts/generate-moonboard-cell-sets.ts",
    "db:export-outline-overrides": "tsx scripts/export-outline-overrides.ts",
    "db:backfill-moonboard-set-ids": "tsx scripts/backfill-moonboard-set-ids.ts",
    "db:backfill-moonboard-hardware": "tsx scripts/backfill-moonboard-hardware.ts",
    "db:repair-woods-rules": "tsx scripts/repair-woods-rules.ts",
    "db:repair-moonboard-8c-grades": "tsx scripts/repair-moonboard-8c-grades.ts",
    "db:backfill-clamped-send-attempts": "tsx scripts/backfill-clamped-send-attempts.ts",
    "db:backfill-shared-feed-tick-boards": "tsx scripts/backfill-shared-feed-tick-boards.ts",
    "db:dedupe-gyms": "tsx scripts/dedupe-gym-locations.ts",
    "db:dedupe-serial-boards": "tsx scripts/dedupe-serial-boards.ts",
    "db:dedupe-beta-links": "tsx scripts/dedupe-beta-links.ts",
    "db:refresh-climb-grades": "tsx scripts/refresh-climb-grades.ts",
    "db:seed-social": "tsx scripts/seed-social.ts",
    "db:create-test-user": "tsx scripts/create-test-user.ts",
    "db:seed-beta-links": "tsx scripts/seed-dev-beta-links.ts",
    "db:load-snapshots": "tsx scripts/load-board-snapshots.ts"
  },
  "dependencies": {
    "@boardsesh/board-config": "workspace:*",
    "@boardsesh/board-constants": "workspace:*",
    "@boardsesh/kiosk": "workspace:*",
    "@boardsesh/shared-schema": "workspace:*",
    "@boardsesh/sync-runtime": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/node": "^25.9.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "sharp": "^0.34.5",
    "tsx": "^4.23.1",
    "typescript": "~7.0.2"
  },
  "peerDependencies": {
    "next-auth": "^4.24.15"
  },
  "peerDependenciesMeta": {
    "next-auth": {
      "optional": true
    }
  }
}
