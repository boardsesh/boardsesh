# =============================================================================
# Dockerfile.dev-db
# Multi-stage build that produces a PostgreSQL + PostGIS image with the whole
# Kilter/Tension/Decoy/Touchstone/Grasshopper/So-iLL/MoonBoard/Woods board
# catalogue, a test user, and social seed data pre-loaded with drizzle
# migrations applied. Developers just pull & run.
#
# The catalogue comes from the nightly board snapshots we already publish for
# offline mode (docs/board-snapshots.md) — not from scraping Aurora APKs and
# running pgloader, which is what this image used to do (issue #4508). The
# snapshots are built from production, so the image ships last night's catalogue
# instead of whatever an APK mirror happened to serve, and dropping pgloader
# (which needs TCP during the build and cannot complete under GitHub's ARM
# emulation) is what lets this image be built for linux/arm64.
#
# Build context: repository root so we can access packages/db/docker scripts,
# packages/db/drizzle migrations, and shared package sources.
#
# PostgreSQL 18 declares /var/lib/postgresql as its VOLUME and defaults PGDATA
# to /var/lib/postgresql/18/docker. The builder therefore creates the seed
# cluster outside the volume. The final image copies that immutable seed into
# PGDATA on the first start of a fresh parent volume.
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: postgres + PostGIS base (same as Dockerfile.postgres)
# ---------------------------------------------------------------------------
FROM postgres:18.4-bookworm@sha256:882236b897e39051d2368c5ccc6cda944904723506b2dfc97f2a8f5bc9afa382 AS postgres-postgis

ARG POSTGIS_PACKAGE_VERSION=3.6.4+dfsg-2.pgdg12+1
ARG HYPOPG_PACKAGE_VERSION=1.4.3-1.pgdg12+1

# The digest pins the exact base artifact. Assert the upstream server version
# separately; the exact PostGIS/HypoPG Debian packages are pinned below.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      "postgresql-18-postgis-3=${POSTGIS_PACKAGE_VERSION}" \
      "postgresql-18-postgis-3-scripts=${POSTGIS_PACKAGE_VERSION}" \
      "postgresql-18-hypopg=${HYPOPG_PACKAGE_VERSION}" && \
    postgres --version | grep -Eq '^postgres \(PostgreSQL\) 18\.4([ .]|$)' && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Stage 2: Builder — migrate an empty cluster, then fill it from the snapshots
# ---------------------------------------------------------------------------
FROM postgres-postgis AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      jq \
      gnupg && \
    # Install Node.js 22 LTS for the TypeScript load/seed scripts. `node:sqlite`
    # (which the snapshot loader reads artifacts with) needs 22.5+.
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Build outside the parent image's /var/lib/postgresql VOLUME. Data written
# below a declared volume during docker build is not a portable image layer.
ENV PGDATA=/opt/boardsesh/dev-db-seed/18/docker

# Where the loader resolves the manifests from. Overridable so a build can be
# pointed at a staging bucket; the default is the public snapshot host.
ARG SNAPSHOT_BASE_URL=https://boardsesh-board-snapshots.t3.tigrisfiles.io
ENV SNAPSHOT_BASE_URL=${SNAPSHOT_BASE_URL}
# Full-URL override for the catalogue manifest alone, so a build can be pointed
# at a locally served artifact while the climb artifacts still come from the
# public host. Empty (the default) resolves it under SNAPSHOT_BASE_URL.
ARG CATALOG_MANIFEST_URL=
ENV CATALOG_MANIFEST_URL=${CATALOG_MANIFEST_URL}

# Build context is the repo root (see dev-db-docker.yml) so we can also reach
# packages/shared-schema below. All paths here are repo-root-relative.

COPY packages/db/docker/legacy-aurora-schema-stub.sql \
     packages/db/docker/bootstrap-pg18-development-roles.sql \
     /db/
COPY packages/db/docker/apply-drizzle-migrations.sh \
     /usr/local/bin/boardsesh-apply-drizzle-migrations
RUN chmod +x /usr/local/bin/boardsesh-apply-drizzle-migrations

# Copy drizzle migration files
COPY packages/db/drizzle/ /drizzle/

# Copy Node.js project files for load/seed scripts
COPY packages/db/package.json /app/package.json
COPY packages/db/scripts/ /app/scripts/
COPY packages/db/src/ /app/src/
COPY packages/db/tsconfig.json /app/tsconfig.json

# The scripts use several @boardsesh/* workspace packages. This isolated image
# can't do a monorepo workspace install, so: strip every workspace dep from
# package.json (a standalone install can't resolve a workspace version), install
# packages/db's own deps, then drop the packages that ARE loaded at runtime
# straight into node_modules.
#
# Loaded at runtime, so copied in below:
#   @boardsesh/shared-schema    the climb-characteristics helper + BoardName
#   @boardsesh/sync-runtime     the fa_at range guard (issue #3536)
#   @boardsesh/board-constants  convertLitUpHoldsStringToMap, which the snapshot
#                               loader derives board_climb_holds with
#
# Stripped and NOT copied, because nothing this build runs loads them:
#   @boardsesh/board-config     runtime required_set_ids helpers
#   @boardsesh/kiosk            type-only import for gym_kiosks.layout
#   sharp                       native; only the cell-set generator uses it
RUN cd /app && \
    sed -i -e '/"@boardsesh\/shared-schema"/d' -e '/"@boardsesh\/board-config"/d' -e '/"@boardsesh\/board-constants"/d' -e '/"@boardsesh\/kiosk"/d' -e '/"@boardsesh\/sync-runtime"/d' -e '/"sharp"/d' package.json && \
    npm install --global --no-fund --no-audit pnpm@11.22.0 && \
    pnpm install --ignore-workspace --ignore-scripts --no-frozen-lockfile
COPY packages/shared-schema/ /app/node_modules/@boardsesh/shared-schema/
COPY packages/sync-runtime/ /app/node_modules/@boardsesh/sync-runtime/
COPY packages/board-constants/ /app/node_modules/@boardsesh/board-constants/

# Single RUN: start PG → migrate → load snapshots → seed → stop PG → clean
RUN set -e && \
    \
    # ── Initialize and start PostgreSQL ────────────────────────────────── \
    echo ">>> Initializing PostgreSQL..." && \
    mkdir -p "$PGDATA" /var/run/postgresql && \
    chown postgres:postgres "$PGDATA" /var/run/postgresql && \
    gosu postgres initdb -D "$PGDATA" --auth-local=trust --auth-host=trust && \
    echo "host all all 0.0.0.0/0 md5" >> "$PGDATA/pg_hba.conf" && \
    gosu postgres pg_ctl -D "$PGDATA" start \
      -o "-c listen_addresses='localhost' -c unix_socket_directories='/var/run/postgresql' -c log_min_messages=warning -c max_wal_size=4GB" && \
    until gosu postgres pg_isready -h /var/run/postgresql; do sleep 1; done && \
    \
    # ── Create database and neon proxy schema ────────────────────────── \
    echo ">>> Creating database 'main' and neon_control_plane schema..." && \
    gosu postgres psql -h /var/run/postgresql postgres -c "CREATE DATABASE main" && \
    gosu postgres psql -h /var/run/postgresql main -c "CREATE SCHEMA IF NOT EXISTS neon_control_plane" && \
    gosu postgres psql -h /var/run/postgresql main -c "CREATE TABLE IF NOT EXISTS neon_control_plane.endpoints (endpoint_id VARCHAR(255) NOT NULL PRIMARY KEY, allowed_ips VARCHAR(255))" && \
    gosu postgres psql -h /var/run/postgresql main -c "ALTER USER postgres WITH PASSWORD 'password'" && \
    \
    # ── Create the empty legacy Aurora tables ───────────────────────────── \
    # 0000 ALTERs kilter_climbs/tension_climbs and 0025 opens with an unguarded \
    # DELETE FROM kilter_beta_links. pgloader used to create those tables; now \
    # they are created empty and 0038 drops them again. \
    echo ">>> Creating legacy Aurora table stubs..." && \
    gosu postgres psql -X -v ON_ERROR_STOP=1 -h /var/run/postgresql -d main \
      -f /db/legacy-aurora-schema-stub.sql && \
    \
    # ── Apply drizzle migrations via psql ─────────────────────────────── \
    # The helper applies each migration and both exact-time ledger rows in one \
    # transaction. Its contracts cover SQL and second-ledger rollback. \
    echo ">>> Applying drizzle migrations..." && \
    gosu postgres psql -X -v ON_ERROR_STOP=1 -h /var/run/postgresql -d main \
      -v boardsesh_dev_role_bootstrap=true \
      -f /db/bootstrap-pg18-development-roles.sql && \
    PGHOST=/var/run/postgresql PGDATABASE=main \
      gosu postgres boardsesh-apply-drizzle-migrations && \
    migration_count=$(jq '.entries | length' /drizzle/meta/_journal.json) && \
    \
    # ── Verify database state ────────────────────────────────────────── \
    echo ">>> Verifying database..." && \
    recorded=$(gosu postgres psql -h /var/run/postgresql main -t -A -c "SELECT count(*) FROM \"__drizzle_migrations\"") && \
    table_count=$(gosu postgres psql -h /var/run/postgresql main -t -A -c "SELECT count(*) FROM pg_tables WHERE schemaname = 'public'") && \
    echo "  Migrations recorded: $recorded / $migration_count" && \
    echo "  Public tables: $table_count" && \
    if [ "$recorded" -ne "$migration_count" ]; then \
      echo "ERROR: Migration count mismatch! Expected $migration_count, got $recorded" && false; \
    fi && \
    \
    # ── Load the board catalogue from the published snapshots ─────────── \
    echo ">>> Loading board snapshots..." && \
    cd /app && \
    mkdir -p /opt/boardsesh && \
    # Positional parameters, not a flat string: both URLs come from build ARGs, \
    # and a space in one would word-split a `$load_args`-style string into \
    # garbage arguments. Quoting the string instead would collapse every flag \
    # into a single argument, so neither half of that shape is safe. \
    set -- --snapshot-base-url "$SNAPSHOT_BASE_URL" --sources-out /opt/boardsesh/snapshot-sources.json && \
    if [ -n "$CATALOG_MANIFEST_URL" ]; then set -- "$@" --catalog-manifest-url "$CATALOG_MANIFEST_URL"; fi && \
    DATABASE_URL=postgresql://postgres@localhost/main node --import tsx scripts/load-board-snapshots.ts "$@" && \
    \
    # ── Create test user ─────────────────────────────────────────────── \
    echo ">>> Creating test user..." && \
    DATABASE_URL=postgresql://postgres@localhost/main node --import tsx scripts/create-test-user.ts && \
    \
    # ── Seed social data ─────────────────────────────────────────────── \
    echo ">>> Seeding social data..." && \
    DATABASE_URL=postgresql://postgres@localhost/main node --import tsx scripts/seed-social.ts && \
    \
    # ── Compact and refresh planner statistics ───────────────────────── \
    # The seed scripts UPDATE stats rows in place; without this the image ships \
    # the dead tuples and stale statistics those updates leave behind. \
    echo ">>> VACUUM FULL ANALYZE..." && \
    gosu postgres psql -X -v ON_ERROR_STOP=1 -h /var/run/postgresql -d main -c "VACUUM (FULL, ANALYZE)" && \
    \
    # ── Stop PostgreSQL ──────────────────────────────────────────────── \
    echo ">>> Stopping PostgreSQL..." && \
    gosu postgres pg_ctl -D "$PGDATA" stop -m fast && \
    \
    # ── Trim the write-ahead log ─────────────────────────────────────── \
    # The load runs with a large max_wal_size so checkpoints stay out of its \
    # way, and Postgres RECYCLES spent segments — renaming them to future \
    # names rather than deleting them — so the frozen seed would otherwise \
    # ship 4 GB of empty WAL (the image published before this change carries \
    # 2 GB of it). Checkpointing does not help: a recycled segment's name is \
    # in the FUTURE, so RemoveOldXlogFiles never considers it old. \
    # \
    # After a clean shutdown the cluster needs exactly one segment — the one \
    # holding the shutdown checkpoint's redo point, which is also where \
    # recovery would start and stop. Every other segment is either already \
    # replayed or an empty recycled placeholder, so deleting them is safe and \
    # Postgres reallocates as it needs them. Verified by booting the trimmed \
    # seed and writing to it. \
    echo ">>> Trimming recycled write-ahead log segments..." && \
    redo_file=$(gosu postgres pg_controldata -D "$PGDATA" | awk -F': *' '/REDO WAL file/ {print $2}' | tr -d ' ') && \
    test -n "$redo_file" && \
    test -f "$PGDATA/pg_wal/$redo_file" && \
    find "$PGDATA/pg_wal" -maxdepth 1 -type f -name '[0-9A-F]*' ! -name "$redo_file" -delete && \
    du -sh "$PGDATA" "$PGDATA/pg_wal" && \
    touch /opt/boardsesh/dev-db-seed.complete && \
    \
    # ── Clean up temporary files ─────────────────────────────────────── \
    rm -rf /drizzle /app && \
    echo ">>> Build complete — database is pre-populated with all board data."

# ---------------------------------------------------------------------------
# Stage 3: Final clean image with only the pre-populated PGDATA
# ---------------------------------------------------------------------------
FROM postgres-postgis

ENV PGDATA=/var/lib/postgresql/18/docker \
    BOARDSESH_DEV_DB_SEED=/usr/local/share/boardsesh-dev-db/18/docker \
    BOARDSESH_DEV_DB_SEED_MARKER=/usr/local/share/boardsesh-dev-db/SEED_COMPLETE

COPY --from=builder --chown=postgres:postgres \
     /opt/boardsesh/dev-db-seed/18/docker /usr/local/share/boardsesh-dev-db/18/docker
COPY --from=builder /opt/boardsesh/dev-db-seed.complete /usr/local/share/boardsesh-dev-db/SEED_COMPLETE
# Exactly which snapshot artifacts this image was built from: keys, sizes, build
# stamps and loaded row counts. The build resolves the live manifests, so this
# is what makes a given image digest traceable back to its inputs.
COPY --from=builder /opt/boardsesh/snapshot-sources.json /usr/local/share/boardsesh-dev-db/SNAPSHOT_SOURCES.json

COPY packages/db/docker/dev-db-entrypoint.sh /usr/local/bin/boardsesh-dev-db-entrypoint
RUN chmod +x /usr/local/bin/boardsesh-dev-db-entrypoint

LABEL org.boardsesh.postgresql.version="18.4" \
      org.boardsesh.postgis.version="3.6.4" \
      org.boardsesh.postgresql.base-digest="sha256:882236b897e39051d2368c5ccc6cda944904723506b2dfc97f2a8f5bc9afa382"

ENTRYPOINT ["boardsesh-dev-db-entrypoint"]
CMD ["postgres"]
