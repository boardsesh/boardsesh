FROM postgres:18.6-bookworm@sha256:1c59e2c3c818eaa0f0628f695b36e7c9e362d6b219b36a54a32df645cbd7e1af

ARG POSTGIS_PACKAGE_VERSION=3.6.4+dfsg-2.pgdg12+1
ARG HYPOPG_PACKAGE_VERSION=1.4.3-1.pgdg12+2

# The digest pins the exact base artifact. Assert the upstream server version
# separately; the exact PostGIS/HypoPG Debian packages are pinned below.
# PGDG moves older extension builds out of its live repository. Trust the same
# upstream key, and permit only HypoPG from the official historical archive.
RUN test -r /usr/local/share/keyrings/postgres.gpg.asc && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    printf '%s\n' \
      'deb [signed-by=/usr/local/share/keyrings/postgres.gpg.asc] https://apt-archive.postgresql.org/pub/repos/apt bookworm-pgdg-archive main' \
      > /etc/apt/sources.list.d/boardsesh-hypopg-archive.list && \
    printf '%s\n' \
      'Package: postgresql-18-hypopg' \
      'Pin: origin apt-archive.postgresql.org' \
      'Pin-Priority: 500' \
      '' \
      'Package: *' \
      'Pin: origin apt-archive.postgresql.org' \
      'Pin-Priority: -1' \
      > /etc/apt/preferences.d/boardsesh-hypopg-archive && \
    apt-get update && \
    # Exercise APT policy during both architecture builds: archived dependencies
    # stay forbidden, while the exact HypoPG version remains installable.
    apt-cache policy postgresql-18 postgresql-18-postgis-3 | \
      awk '/apt-archive[.]postgresql[.]org/ { if ($1 != -1) exit 1; found = 1 } END { if (!found) exit 1 }' && \
    test "$(apt-cache policy postgresql-18-hypopg | awk -v expected="$HYPOPG_PACKAGE_VERSION" '$1 == expected { print $2 }')" = 500 && \
    apt-get install -y --no-install-recommends \
      "postgresql-18-postgis-3=${POSTGIS_PACKAGE_VERSION}" \
      "postgresql-18-postgis-3-scripts=${POSTGIS_PACKAGE_VERSION}" \
      "postgresql-18-hypopg=${HYPOPG_PACKAGE_VERSION}" && \
    postgres --version | grep -Eq '^postgres \(PostgreSQL\) 18\.6([ .]|$)' && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# TLS material arrives as PG_TLS_SERVER_CERT / PG_TLS_SERVER_KEY and is written
# to the volume, outside PGDATA, by this wrapper. It is a no-op when those are
# unset, so local dev, CI and the homelab DR standby boot unchanged.
#
# ENTRYPOINT resets an inherited CMD, so the upstream default is restated here.
COPY postgres-entrypoint.sh /usr/local/bin/boardsesh-postgres-entrypoint.sh
RUN chmod 0755 /usr/local/bin/boardsesh-postgres-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/boardsesh-postgres-entrypoint.sh"]
CMD ["postgres"]

LABEL org.boardsesh.postgresql.version="18.6" \
      org.boardsesh.postgis.version="3.6.4" \
      org.boardsesh.postgresql.base-digest="sha256:1c59e2c3c818eaa0f0628f695b36e7c9e362d6b219b36a54a32df645cbd7e1af"
