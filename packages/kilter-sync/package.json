{
  "name": "@boardsesh/kilter-sync",
  "version": "1.0.0",
  "description": "Kilter Grips (Keycloak + PowerSync + REST) sync utility for Boardsesh",
  "license": "AGPL-3.0-or-later",
  "bin": {
    "kilter-sync": "./dist/cli/index.js"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runner": {
      "types": "./src/runner/index.ts",
      "import": "./src/runner/index.ts",
      "default": "./src/runner/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "import": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./sync": {
      "types": "./src/sync/index.ts",
      "import": "./src/sync/index.ts",
      "default": "./src/sync/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "lint-fix": "vp lint --fix",
    "sync:catalog": "tsx src/cli/index.ts catalog",
    "sync:daemon": "tsx src/cli/index.ts daemon",
    "sync:locations": "tsx src/cli/index.ts locations --skip-if-missing-credentials",
    "sync:repair-stats": "tsx src/cli/index.ts repair-stats",
    "sync:user": "tsx src/cli/index.ts user"
  },
  "dependencies": {
    "@boardsesh/board-constants": "workspace:*",
    "@boardsesh/crypto": "workspace:*",
    "@boardsesh/db": "workspace:*",
    "@boardsesh/location-sync": "workspace:*",
    "@boardsesh/shared-schema": "workspace:*",
    "@boardsesh/sync-runtime": "workspace:*",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.6",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "tsx": "^4.23.1",
    "typescript": "~7.0.2"
  }
}
