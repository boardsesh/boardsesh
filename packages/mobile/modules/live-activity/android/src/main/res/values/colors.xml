<?xml version="1.0" encoding="utf-8"?>
<!-- Brand fallback for API 24-30. values-v31/colors.xml overrides these with
     Material You (system_accent1 / system_neutral) on Android 12+. -->
<resources>
    <!-- Boardsesh green; tints the notification accent (small icon + app name). -->
    <color name="session_accent">#3DA35D</color>
    <!-- Dimmed accent for the "off" (reconnect) lightbulb. -->
    <color name="session_accent_dim">#9AA0A6</color>
    <!-- Near-black backing behind the climb thumbnail (matches the rounded bitmap
         backing) so the fitCenter letterbox bars + load state read dark, not white. -->
    <color name="session_image_placeholder">#FF0A0A0A</color>
    <!-- Rest digits once past the rest length ("over your rest"), the app's red.
         values-night/colors.xml lightens it for the dark notification surface. -->
    <color name="session_rest_over">#D93025</color>
    <!-- Rest digits once the queue has run out: still counting, but quiet.
         values-night/colors.xml lightens it for the dark notification surface. -->
    <color name="session_rest_muted">#5F6368</color>

    <!-- The lock screen card. Pinned, with no night or Material You variants: the
         card is always dark, so a wallpaper accent or light theme can't reach it. -->
    <color name="session_card_surface">#0E0D12</color>
    <color name="session_card_ink">#F5F2FB</color>
    <color name="session_card_secondary">#A9A2B6</color>
    <!-- The collapsed strip has holds right under its text, so its line is lighter:
         4.5:1 over the brightest one. A heavier scrim would hide the glow instead. -->
    <color name="session_card_meta_collapsed">#D3CEDD</color>
    <color name="session_card_rest">#A78BFA</color>
    <color name="session_card_rest_over">#F87171</color>
</resources>
