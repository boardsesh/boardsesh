<?xml version="1.0" encoding="utf-8"?>
<!-- A timed drive: an amber ring that drains as the drive runs out. The level sets
     how far round it is drawn, starting from 12 o'clock. A tap stops the drive. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="24dp"
        android:height="24dp">
        <rotate
            android:fromDegrees="-90"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="-90">
            <shape
                android:innerRadius="10dp"
                android:shape="ring"
                android:thickness="1.5dp"
                android:useLevel="true">
                <solid android:color="#FBBF24" />
                <size
                    android:width="24dp"
                    android:height="24dp" />
            </shape>
        </rotate>
    </item>
    <item android:drawable="@drawable/session_card_bulb_ring_glyph" />
</layer-list>
