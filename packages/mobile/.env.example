# Mobile defaults to production: BACKEND_URL=https://ws.boardsesh.com,
# WS_URL=wss://ws.boardsesh.com/graphql, WEB_URL=https://www.boardsesh.com.
# This file is the override template — copy to .env.development.local
# only when you actually want to hit a local backend (e.g. for testing
# a websocket schema change). For day-to-day mobile work against the
# production API there is nothing to set.

# EXPO_PUBLIC_BACKEND_URL=http://localhost:8080
# EXPO_PUBLIC_WS_URL=ws://localhost:8080/graphql
# EXPO_PUBLIC_WEB_URL=http://localhost:3000

# EAS Update credentials — required for the in-app Branch Switcher to fetch
# and remap branches on preview builds. Leave unset for dev/production builds.
EXPO_PUBLIC_EAS_TOKEN=
EXPO_PUBLIC_EAS_PROJECT_ID=

# PostHog analytics. Same project token as the web app (NEXT_PUBLIC_POSTHOG_KEY)
# so a signed-in user's web + mobile activity resolves to one person. Analytics
# only sends from non-dev builds (mirrors Sentry's !__DEV__ gate), so set this as
# an EAS build-time env/secret — EXPO_PUBLIC_* vars are inlined when the bundle is
# built, not read at runtime. Host defaults to https://us.i.posthog.com.
# EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Native social login (Sign in with Apple + Google Sign-In). These are OAuth
# client *identifiers* (public, embedded in the app), not secrets. Set them as
# EAS build-time env so they're inlined into the native build — native modules
# can't be OTA-updated, so changing them needs a rebuild.
#
# Google OAuth client IDs from Google Cloud Console. webClientId is the audience
# @react-native-google-signin requests; the iOS client id derives the reversed
# URL scheme (or set EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME explicitly).
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=1234567890-def.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-ghi.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.1234567890-abc
#
# The backend verifies these tokens and must share the same identifiers:
#   APPLE_BUNDLE_ID (default com.boardsesh.app), GOOGLE_IOS_CLIENT_ID,
#   GOOGLE_ANDROID_CLIENT_ID, GOOGLE_WEB_CLIENT_ID — set on the backend, not here.
