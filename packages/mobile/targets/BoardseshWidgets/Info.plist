  <dict>
    <key>NSExtension</key>
    <dict>
      <key>NSExtensionPointIdentifier</key>
      <string>com.apple.widgetkit-extension</string>
    </dict>
    <key>BoardseshHostBundleIdentifier</key>
    <string>$(BOARDSESH_HOST_BUNDLE_IDENTIFIER)</string>
