{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development-device",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview-1",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "channel": "production"
    },
    "development-testflight": {
      "developmentClient": true,
      "distribution": "store",
      "channel": "development-testflight",
      "env": {
        "BOARDSESH_IOS_APP_VARIANT": "dev"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Debug"
      }
    }
  }
}
