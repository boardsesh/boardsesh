{
  "name": "@boardsesh/aurora-sync",
  "version": "1.0.0",
  "description": "Aurora board sync utility for Boardsesh",
  "bin": {
    "aurora-sync": "./dist/cli/index.js"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runner": {
      "types": "./src/runner/index.ts",
      "import": "./src/runner/index.ts",
      "default": "./src/runner/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "import": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./sync": {
      "types": "./src/sync/index.ts",
      "import": "./src/sync/index.ts",
      "default": "./src/sync/index.ts"
    },
    "./json-import": {
      "types": "./src/sync/json-import.ts",
      "import": "./src/sync/json-import.ts",
      "default": "./src/sync/json-import.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "lint-fix": "vp lint --fix",
    "sync:all": "tsx src/cli/index.ts all",
    "sync:daemon": "tsx src/cli/index.ts daemon",
    "sync:locations": "tsx src/cli/index.ts locations",
    "sync:user": "tsx src/cli/index.ts user"
  },
  "dependencies": {
    "@boardsesh/board-config": "*",
    "@boardsesh/board-constants": "*",
    "@boardsesh/crypto": "*",
    "@boardsesh/db": "*",
    "@boardsesh/location-sync": "*",
    "@boardsesh/shared-schema": "*",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
