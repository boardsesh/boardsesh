{
  "name": "@boardsesh/aurora-sync",
  "version": "1.0.0",
  "description": "Aurora board sync utility for Boardsesh",
  "bin": {
    "aurora-sync": "./bin/aurora-sync.mjs"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runner": {
      "types": "./src/runner/index.ts",
      "import": "./src/runner/index.ts",
      "default": "./src/runner/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "import": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./sync": {
      "types": "./src/sync/index.ts",
      "import": "./src/sync/index.ts",
      "default": "./src/sync/index.ts"
    },
    "./apply-user-logbook": {
      "types": "./src/sync/apply-user-logbook.ts",
      "import": "./src/sync/apply-user-logbook.ts",
      "default": "./src/sync/apply-user-logbook.ts"
    },
    "./json-import": {
      "types": "./src/sync/json-import.ts",
      "import": "./src/sync/json-import.ts",
      "default": "./src/sync/json-import.ts"
    },
    "./normalize-timestamp": {
      "types": "./src/sync/normalize-timestamp.ts",
      "import": "./src/sync/normalize-timestamp.ts",
      "default": "./src/sync/normalize-timestamp.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "lint-fix": "vp lint --fix",
    "sync:all": "tsx src/cli/index.ts all",
    "sync:daemon": "tsx src/cli/index.ts daemon",
    "sync:locations": "tsx src/cli/index.ts locations",
    "sync:user": "tsx src/cli/index.ts user"
  },
  "dependencies": {
    "@boardsesh/board-config": "workspace:*",
    "@boardsesh/board-constants": "workspace:*",
    "@boardsesh/crypto": "workspace:*",
    "@boardsesh/db": "workspace:*",
    "@boardsesh/location-sync": "workspace:*",
    "@boardsesh/shared-schema": "workspace:*",
    "@boardsesh/sync-runtime": "workspace:*",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "typescript": "~7.0.2"
  }
}
