+      "offsetDp" to (current?.firstVisibleItemScrollOffset?.toDouble()?.div(densityScale) ?: initialPosition?.offsetDp ?: 0.0)
+    )
+  }
+
+  suspend fun scrollToItem(request: LazyListScrollRequest): Unit = withContext(Dispatchers.Main.immediate) {
+    require(request.alignment == "start" || request.alignment == "center") { "Unsupported lazy-list alignment" }
+    if (request.requestId <= latestRequestId) return@withContext
+    if (request.alignment == "center" && userInteracted && !request.allowAfterInteraction) return@withContext
