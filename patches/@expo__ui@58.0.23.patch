+      }
+    }
+    pendingScroll = scrollJob
+    scrollJob.start()
+    return scrollJob
+  }
+
+  internal fun cancelScrollOnTouch(): Modifier = Modifier.pointerInput(this) {
+    awaitEachGesture {
+      awaitFirstDown(requireUnconsumed = false, pass = PointerEventPass.Initial)
