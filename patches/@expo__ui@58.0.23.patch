+          val targetIndex = request.index.coerceIn(0, measured.totalItemsCount - 1)
+          current.state.scrollToItem(targetIndex)
+          if (request.alignment == "center") {
+            val target = snapshotFlow {
+              current.state.layoutInfo.visibleItemsInfo.firstOrNull { it.index == targetIndex }
+            }.first { it != null }!!
+            val layout = current.state.layoutInfo
+            val viewportCenter = (layout.viewportStartOffset + layout.viewportEndOffset) / 2f
+            current.state.scrollBy(target.offset + target.size / 2f - viewportCenter)
+          }
