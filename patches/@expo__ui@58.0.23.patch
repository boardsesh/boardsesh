+        do {
+          val pointerEvent = awaitPointerEvent(PointerEventPass.Initial)
+        } while (pointerEvent.changes.any { it.pressed })
+      } finally {
+        touching = false
+      }
+    }
+  }
+}
+
+@Composable
+internal fun rememberControlledLazyListState(
+  controller: LazyListScrollController,
+  initialPosition: LazyListScrollPosition?
+): LazyListState {
+  val density = LocalDensity.current
+  val scope = rememberCoroutineScope()
+  val state = controller.obtainState(initialPosition, density)
+  SideEffect { controller.attach(state, scope, density) }
+  DisposableEffect(controller) {
+    onDispose { controller.detach() }
+  }
+  return state
+}
