+  private data class PendingRequest(val request: LazyListScrollRequest, val touchGeneration: Int)
+  private var pendingScroll: Job? = null
+  private var desiredRequest: PendingRequest? = null
+  private var latestRequestId = Int.MIN_VALUE
+  private var touching = false
+  private var userInteracted = false
+  private var touchGeneration = 0
