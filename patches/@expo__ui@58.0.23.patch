+    if (request.allowAfterInteraction) userInteracted = false
+    val desired = PendingRequest(request, touchGeneration)
+    desiredRequest = desired
+    val current = binding.value ?: return@withContext
+    scheduleScroll(current, desired).join()
+    Unit
+  }
+
+  private fun scheduleScroll(current: Binding, desired: PendingRequest): Job {
+    // As with HorizontalPager, use the composition scope for its frame clock.
+    // Lazy start registers the job before an immediate completion can clear it.
+    val scrollJob = current.scope.launch(start = CoroutineStart.LAZY) {
+      try {
+        val completed = withTimeoutOrNull(LAZY_LIST_LAYOUT_TIMEOUT_MS) {
