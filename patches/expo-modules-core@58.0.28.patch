@@ -2,6 +2,7 @@ package expo.modules.kotlin.views
 
 import android.view.View
 import android.view.ViewGroup
+import com.facebook.react.bridge.ReadableArray
 import com.facebook.react.uimanager.ReactStylesDiffMap
 import com.facebook.react.uimanager.StateWrapper
 import com.facebook.react.uimanager.ThemedReactContext
@@ -53,6 +54,16 @@ class GroupViewManagerWrapper(
     return props
   }
 
+  // Fabric delivers view commands (e.g. Reanimated's dispatchCommand) here; without a
+  // delegate React Native drops them. Views opt in through ExpoViewCommandReceiver.
+  override fun receiveCommand(view: ViewGroup, commandId: String, args: ReadableArray?) {
+    val receiver = view as? ExpoViewCommandReceiver
+    if (receiver != null && receiver.receiveViewCommand(commandId, args?.toArrayList() ?: emptyList())) {
+      return
+    }
+    super.receiveCommand(view, commandId, args)
+  }
+
   override fun onDropViewInstance(view: ViewGroup) {
     super.onDropViewInstance(view)
     viewWrapperDelegate.onDestroy(view)
