diff --git a/ios/tabs/bottom-accessory/RNSAccessoryPresentationSettler.h b/ios/tabs/bottom-accessory/RNSAccessoryPresentationSettler.h
new file mode 100644
--- /dev/null
+++ b/ios/tabs/bottom-accessory/RNSAccessoryPresentationSettler.h
@@ -0,0 +1,36 @@
+#pragma once
+
+// No UIKit dependency: the transition/timeout policy is exercised by portable tests.
+namespace rnscreens {
+enum class AccessoryPresentationSample { Pending, Settled, TimedOut };
+
+class AccessoryPresentationSettler {
+ public:
+  bool begin(double now) {
+    const bool shouldPublishMoving = !moving_;
+    if (!moving_) deadline_ = now + 2.0;
+    moving_ = true;
+    stableFrames_ = 0;
+    return shouldPublishMoving;
+  }
+
+  AccessoryPresentationSample sample(double now, bool geometryIsStable) {
+    if (!moving_) return AccessoryPresentationSample::Pending;
+    if (now >= deadline_) {
+      reset();
+      return AccessoryPresentationSample::TimedOut;
+    }
+    stableFrames_ = geometryIsStable ? stableFrames_ + 1 : 0;
+    if (stableFrames_ < 2) return AccessoryPresentationSample::Pending;
+    reset();
+    return AccessoryPresentationSample::Settled;
+  }
+
+  void reset() { moving_ = false; stableFrames_ = 0; }
+
+ private:
+  bool moving_ = false;
+  unsigned stableFrames_ = 0;
+  double deadline_ = 0;
+};
+} // namespace rnscreens
