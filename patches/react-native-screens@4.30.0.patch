+// Depth-first search for this screen's own scroll view. It never descends into a
+// nested screen, so an outer screen's edge effects cannot overwrite an inner one's.
+static const NSInteger RNSEdgeEffectScrollViewSearchMaxDepth = 24;
+
+static UIScrollView *_Nullable rnscreens_findOwnEdgeEffectScrollView(UIView *_Nullable view, UIView *_Nonnull screen, NSInteger depth)
+{
+  if (view == nil || depth < 0) {
+    return nil;
+  }
+  if (view != screen && [view isKindOfClass:RNSScreenView.class]) {
+    return nil;
+  }
+  if ([view isKindOfClass:UIScrollView.class]) {
+    return static_cast<UIScrollView *>(view);
+  }
+  for (UIView *subview in view.subviews) {
+    UIScrollView *found = rnscreens_findOwnEdgeEffectScrollView(subview, screen, depth - 1);
+    if (found != nil) {
+      return found;
+    }
+  }
+  return nil;
+}
+
 - (void)updateContentScrollViewEdgeEffectsIfExists
 {
-  [RNSScrollEdgeEffectApplicator applyToScrollView:[RNSScrollViewFinder findScrollViewInFirstDescendantChainFrom:self]
-                                      withProvider:self];
+  UIScrollView *scrollView = [RNSScrollViewFinder findScrollViewInFirstDescendantChainFrom:self];
+  if (scrollView == nil) {
+    // The first-child walk stops at any leading sibling, and FlashList nests its
+    // UIScrollView below wrappers, so `scrollEdgeEffects` never reached it and
+    // iOS 26 kept drawing its top edge effect over full-bleed heroes.
+    scrollView = rnscreens_findOwnEdgeEffectScrollView(self, self, RNSEdgeEffectScrollViewSearchMaxDepth);
+  }
+  if (scrollView == nil) {
+    return;
+  }
+  [RNSScrollEdgeEffectApplicator applyToScrollView:scrollView withProvider:self];
 }
 
