+// Each initialized SDK has its own transport. Retiring one never reopens it.
+private final class ReplayConsentTransport {
+    static let header = "X-Boardsesh-Replay-Generation"
+    private static let registryLock = NSLock()
+    private static var registry: [String: ReplayConsentTransport] = [:]
+    let identifier = UUID().uuidString
+    let storageToken: String
+    let publicToken: String
+    private let lock = NSLock()
+    private var sealed = false
+    private var tasks: [UUID: URLSessionDataTask] = [:]
+    init(publicToken: String) {
+        self.publicToken = publicToken
+        self.storageToken = publicToken + "-boardsesh-replay-" + UUID().uuidString
+        Self.registryLock.lock()
+        Self.registry[identifier] = self
+        Self.registryLock.unlock()
+    }
+    static func find(_ identifier: String) -> ReplayConsentTransport? {
+        registryLock.lock(); defer { registryLock.unlock() }
+        return registry[identifier]
+    }
+    func add(_ task: URLSessionDataTask, identifier: UUID) -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        guard !sealed else { return false }
+        tasks[identifier] = task
+        return true
+    }
+    func finish(_ identifier: UUID) -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        tasks.removeValue(forKey: identifier)
+        return !sealed
+    }
+    func retire() {
+        lock.lock()
+        sealed = true
+        let pending = Array(tasks.values)
+        tasks.removeAll()
+        lock.unlock()
+        Self.registryLock.lock()
+        Self.registry.removeValue(forKey: identifier)
+        Self.registryLock.unlock()
+        pending.forEach { $0.cancel() }
+    }
+
+    // projectToken also names the private SDK queue directory. A unique token
+    // isolates old queue writes; only this transport maps it to the real key.
+    func rewrite(_ request: inout URLRequest) throws {
+        if let url = request.url {
+            request.url = URL(string: url.absoluteString.replacingOccurrences(of: storageToken, with: publicToken))
+        }
+        var payload = request.httpBody
+        if payload == nil, let stream = request.httpBodyStream {
+            stream.open(); defer { stream.close() }
+            var collected = Data()
+            var buffer = [UInt8](repeating: 0, count: 65536)
+            while stream.hasBytesAvailable {
+                let count = stream.read(&buffer, maxLength: buffer.count)
+                if count < 0 { throw stream.streamError ?? URLError(.cannotDecodeContentData) }
+                if count == 0 { break }
+                collected.append(contentsOf: buffer.prefix(count))
+                if collected.count > 16 * 1024 * 1024 { throw URLError(.dataLengthExceedsMaximum) }
+            }
+            payload = collected
+        }
+        guard let payload else {
+            if request.httpMethod == "POST" { throw URLError(.cannotDecodeContentData) }
+            return
+        }
+        let compressed = request.value(forHTTPHeaderField: "Content-Encoding") == "gzip"
+        let decoded = compressed ? try gzip(payload, compress: false) : payload
+        guard let json = String(data: decoded, encoding: .utf8) else { throw URLError(.cannotDecodeContentData) }
+        let rewritten = Data(json.replacingOccurrences(of: storageToken, with: publicToken).utf8)
+        request.httpBodyStream = nil
+        request.httpBody = compressed ? try gzip(rewritten, compress: true) : rewritten
+        request.setValue(nil, forHTTPHeaderField: "Content-Length")
+    }
+
+    private func gzip(_ input: Data, compress: Bool) throws -> Data {
+        var stream = z_stream()
+        let initialized = compress
+            ? deflateInit2_(&stream, Z_DEFAULT_COMPRESSION, Z_DEFLATED, 31, 8, Z_DEFAULT_STRATEGY, ZLIB_VERSION, Int32(MemoryLayout<z_stream>.size))
+            : inflateInit2_(&stream, 47, ZLIB_VERSION, Int32(MemoryLayout<z_stream>.size))
+        guard initialized == Z_OK else { throw URLError(.cannotDecodeContentData) }
+        defer { if compress { deflateEnd(&stream) } else { inflateEnd(&stream) } }
+        return try input.withUnsafeBytes { inputBytes in
+            stream.next_in = UnsafeMutablePointer<Bytef>(mutating: inputBytes.bindMemory(to: Bytef.self).baseAddress)
+            stream.avail_in = uInt(input.count)
+            var output = Data()
+            var buffer = [UInt8](repeating: 0, count: 65536)
+            var status = Z_OK
+            repeat {
+                status = buffer.withUnsafeMutableBytes { outputBytes in
+                    stream.next_out = outputBytes.bindMemory(to: Bytef.self).baseAddress
+                    stream.avail_out = uInt(outputBytes.count)
+                    return compress ? deflate(&stream, Z_FINISH) : inflate(&stream, Z_NO_FLUSH)
+                }
+                let written = buffer.count - Int(stream.avail_out)
+                output.append(contentsOf: buffer.prefix(written))
+                if output.count > 16 * 1024 * 1024 { throw URLError(.dataLengthExceedsMaximum) }
+            } while status == Z_OK
+            guard status == Z_STREAM_END else { throw URLError(.cannotDecodeContentData) }
+            return output
+        }
+    }
+
+    func configuration() -> URLSessionConfiguration {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.protocolClasses = [ReplayConsentURLProtocol.self]
+        configuration.httpAdditionalHeaders = [Self.header: identifier]
+        return configuration
+    }
+}
+
+private final class ReplayConsentURLProtocol: URLProtocol {
+    private var forwardingTask: URLSessionDataTask?
+    private var forwardingSession: URLSession?
+    override class func canInit(with request: URLRequest) -> Bool {
+        request.url?.scheme == "https" || request.url?.scheme == "http"
+    }
+    override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+    override func startLoading() {
+        guard let identifier = request.value(forHTTPHeaderField: ReplayConsentTransport.header),
+              let transport = ReplayConsentTransport.find(identifier) else {
+            client?.urlProtocol(self, didFailWithError: URLError(.cancelled))
+            return
+        }
+        var forwarded = request
+        forwarded.setValue(nil, forHTTPHeaderField: ReplayConsentTransport.header)
+        do { try transport.rewrite(&forwarded) }
+        catch { client?.urlProtocol(self, didFailWithError: error); return }
+        let configuration = URLSessionConfiguration.ephemeral
+        // Avoid recursive interception and avoid shared cookies/cache.
+        configuration.protocolClasses = []
+        let session = URLSession(configuration: configuration)
+        forwardingSession = session
+        let taskId = UUID()
+        let pending = session.dataTask(with: forwarded) { [weak self] payload, response, error in
+            guard let self else { return }
+            defer { session.finishTasksAndInvalidate() }
+            guard transport.finish(taskId) else {
+                self.client?.urlProtocol(self, didFailWithError: URLError(.cancelled))
+                return
+            }
+            if let error { self.client?.urlProtocol(self, didFailWithError: error); return }
+            if let response { self.client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed) }
+            if let payload { self.client?.urlProtocol(self, didLoad: payload) }
+            self.client?.urlProtocolDidFinishLoading(self)
+        }
+        forwardingTask = pending
+        if transport.add(pending, identifier: taskId) { pending.resume() }
+        else { pending.cancel(); client?.urlProtocol(self, didFailWithError: URLError(.cancelled)) }
+    }
+    override func stopLoading() {
+        forwardingTask?.cancel()
+        forwardingSession?.invalidateAndCancel()
+    }
+}
