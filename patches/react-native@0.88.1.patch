 }
 
 Scheduler::~Scheduler() {
+  // Boardsesh #5293: queued rendering work must not call a retired delegate.
+  // RN 0.88 removed the rollout flag and its token; preserve the enabled guard.
+  *delegateInvalidated_ = true;
+
   LOG(WARNING) << "Scheduler::~Scheduler() was called (address: " << this
