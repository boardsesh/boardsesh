+++ b/ios/tabs/host/RNSTabsHostComponentView.mm
@@ -53,6 +53,8 @@ namespace react = facebook::react;
 
 #if RNS_TABS_BOTTOM_ACCESSORY_AVAILABLE
   UIView *_Nullable _bottomAccessoryWrapperView;
