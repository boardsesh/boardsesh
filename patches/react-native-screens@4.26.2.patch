+    _rnscreens_bottomAccessoryRelayoutNeedsRepeat = NO;
+    [self rnscreens_scheduleBottomAccessoryRelayoutAfterVisibilityChange];
+  }
 #endif // RNS_TABS_BOTTOM_ACCESSORY_AVAILABLE
+}
 
