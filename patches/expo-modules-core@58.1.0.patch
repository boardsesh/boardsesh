+++ b/android/src/main/java/expo/modules/kotlin/views/ExpoViewCommandReceiver.kt
@@ -0,0 +1,16 @@
+package expo.modules.kotlin.views
+
+/**
+ * Lets an Expo view receive Fabric view commands, such as the ones Reanimated's
+ * `dispatchCommand` sends from a UI-thread worklet. The view manager wrappers
+ * forward every command to a view that implements this interface; without it
+ * React Native drops the command, because the wrappers have no delegate.
+ */
+interface ExpoViewCommandReceiver {
+  /**
+   * [args] holds the command's arguments as `ReadableArray.toArrayList()` gives
+   * them: numbers are Doubles. Returns true when the view handled the command,
+   * false to fall through to React Native.
+   */
+  fun receiveViewCommand(commandId: String, args: List<Any?>): Boolean
+}
